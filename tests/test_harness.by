"""The headless harness against the real native core: composition, commit,
layout, hit testing and text editing end to end."""

from basedpython_ui import (
    composable, state, state_list, derived, keyed, on_key, input_modifiers, disposable_effect,
    Column, Row, Text, Button, TextField,
    Checkbox, Modifier, Canvas, Layout, Scroll, TextStyle, Alignment, MeasureScope, Constraints, Size, compose_test,
    chord_of_text, system_theme, window_size, WindowEvents, Popup, Spacer, input_position, selected_text, CursorShape,
    State, LazyColumn, Image, load_image, remember, Side,
)
import time

from basedpython_ui.geometry import Dp, Color
from basedpython_ui.runtime import live_runtimes


@composable
def Counter(step: int = 1):
    let count = state(0)
    Column(Modifier().padding(8)):
        Text(f"count = {count.value}")
        Row:
            Button("+"):
                count.value += step
            Button("reset", enabled=count.value != 0):
                count.value = 0


def test_counter_end_to_end():
    let t = compose_test:
        Counter(step=2)
    assert t.find_text("count = 0")
    t.click("+")
    t.advance()
    assert t.find_text("count = 2"), t.dump()
    t.click("+")
    t.advance()
    assert t.find_text("count = 4"), t.dump()
    assert t.recompositions(Counter) == 3
    t.click("reset")
    t.advance()
    assert t.find_text("count = 0"), t.dump()
    t.dispose()


frozen data class Todo:
    id: int
    title: str
    done: bool = False


@composable
def Todos():
    let todos = state_list([Todo(1, "alpha"), Todo(2, "beta")])
    let draft = state("")
    let remaining = derived(lambda: sum(1 for t in todos if not t.done))
    Column:
        Text(f"{remaining.value} left")
        TextField(draft.value, placeholder="what needs doing?"):
            draft.value = it
        Button("add", enabled=draft.value != ""):
            todos.append(Todo(len(todos) + 1, draft.value))
            draft.value = ""
        todos.each_indexed(key=lambda todo: todo.id):
            let row = it
            Row:
                Checkbox(row.item.done):
                    todos[row.index] = Todo(row.item.id, row.item.title, it)
                Text(row.item.title)


def test_text_input_checkbox_and_keyed_rows():
    let t = compose_test:
        Todos()
    assert t.find_text("2 left") and t.find_text("alpha") and t.find_text("beta")
    t.type_into("what needs doing?", "gamma")
    t.advance()
    t.click("add")
    t.advance()
    assert t.find_text("gamma"), t.dump()
    assert t.find_text("3 left"), t.dump()
    t.dispose()


def flow(scope: MeasureScope, constraints: Constraints) -> Size:
    var x = 0.0
    var tallest = 0.0
    for i in range(scope.child_count):
        let size = scope.measure(i, constraints.loose())
        scope.place(i, x, 0.0)
        x += size.width
        tallest = max(tallest, size.height)
    return Size(x, tallest)


@composable
def Custom():
    Layout(flow):
        Text("one")
        Text("two")
    Canvas(Modifier().size(50, 20)):
        rect(0.0, 0.0, size.width, size.height, "#ff0000")


def test_custom_layout_and_canvas_run_through_the_core():
    let t = compose_test:
        Custom()
    assert t.find_text("one") and t.find_text("two"), t.dump()
    assert "canvas" in t.dump().lower(), t.dump()
    t.dispose()


private def line_of_text(path: str, needle: str) -> int:
    """The 1-based line of the one line containing `needle` in the file at `path`."""
    with open(path, encoding="utf-8") as handle:
        lines = handle.read().splitlines()
    hits = [index + 1 for index, line in enumerate(lines) if needle in line]
    assert len(hits) == 1, f"{needle!r} must appear exactly once in {path}, found it on lines {hits}"
    return hits[0]


def test_why_explains_the_counter_recomposition():
    let t = compose_test:
        Counter(step=2)
    runtime = t.runtime
    assert any(other === runtime for other in live_runtimes)
    t.click("+")
    t.advance()
    runs = t.why(Counter)
    assert [run.origin for run in runs] == ["first", "self"]
    reruns = [run for run in runs if run.origin != "first"]
    assert len(reruns) == 1 and len(reruns[0].causes) == 1
    run = reruns[0]
    cause = run.causes[0]
    assert cause.kind == "state" and cause.name == "count" and cause.old == 0 and cause.new == 2 and not cause.posted
    raw: dynamic = cause.raw
    generated: dynamic = run.raw[5]
    # the needles are spelled in two parts so that these lines do not match themselves
    assert raw[10] == generated and raw[11] == line_of_text(generated, "count.value" + " += step")
    by_file = cause.file
    by_line = cause.line
    assert by_file is not None and by_line is not None and by_file.endswith("tests/test_harness.by")
    # the .by line comes from out/_by_sourcemap.py: the lines of a hoisted handler block map
    # back to the handler's own lines, so the write is located on the line that wrote it
    assert by_line == line_of_text(by_file, "count.value" + " += step")
    # `co_firstlineno` of a decorated function is the line of its first decorator
    assert run.defined[0] == by_file and run.defined[1] == line_of_text(by_file, "def Counter" + "(step: int = 1):") - 1
    text = t.explain(since_frame=runtime.frames - 1)
    assert "count (state) set 0 → 2 at " in text and "Counter#" in text
    t.dispose()
    assert all(other !== runtime for other in live_runtimes)


def test_compose_test_is_a_context_manager():
    with compose_test(root=Counter) as t:
        runtime = t.runtime
        assert any(other === runtime for other in live_runtimes)
        t.click("+")
        t.advance()
        assert t.find_text("count = 1"), t.dump()
    assert all(other !== runtime for other in live_runtimes), "leaving the block disposed it"


def test_compose_test_without_tracing():
    let t = compose_test(trace=False):
        Counter(step=2)
    t.click("+")
    t.advance()
    assert t.find_text("count = 2"), t.dump()
    assert t.why(Counter) == () and t.runtime.trace is None

@composable
def Rows():
    let selected = state(0)

    def handle(chord: str) -> bool:
        if chord == "down":
            selected.value += 1
            return True
        if chord == "up":
            selected.value -= 1
            return True
        return False

    on_key(handle)
    Column(Modifier().size(200, 100)):
        Scroll(Modifier().fill_max_size()):
            keyed(range(10)).each(key=lambda i: i):
                let i = it
                Text(
                    f"row {i}",
                    Modifier().height(30).fill_max_width().reveal(i == selected.value).hover("#eeeeee").clickable(lambda: selected.set(i)),
                )


def test_scroll_container_wheel_reveal_hover_and_keys():
    let t = compose_test(width=200, height=100):
        Rows()
    assert t.find_text("row 0") and t.find_text("row 9"), t.dump()
    assert t.rect_of("row 9")[1] >= 100.0, "the last row starts below the viewport"
    assert t.scroll("row 1", 60.0)
    assert t.rect_of("row 0")[1] == -60.0 and t.scroll_offset() == 60.0, t.dump()
    assert not t.scroll("row 1", -1000.0) or t.scroll_offset() == 0.0
    t.hover("row 3")
    assert t.hovered_handler() >= 0, "a hoverable row reports its handler"
    for _ in range(5):
        assert t.press("down")
    t.advance()
    let y = t.rect_of("row 5")[1]
    assert 0.0 <= y and y + 30.0 <= 100.0, f"the selected row was scrolled into view: {t.dump()}"
    assert not t.press("left"), "an unbound chord is declined"
    assert t.rect_of("row 2")[1] < 0.0, "row 2 is scrolled out, so it cannot be clicked"
    t.click("row 4")
    t.advance()
    assert t.press("up") and t.press("up")
    t.advance()
    assert 0.0 <= t.rect_of("row 2")[1] <= 70.0, f"the selection went back to row 2 and revealed it: {t.dump()}"
    assert "Scroll" in t.dump()
    t.dispose()


@composable
def ModifierClicks():
    let seen = state("")
    Column:
        Button("pick"):
            seen.value = input_modifiers()
        Text(f"mods={seen.value!r}")


def test_click_modifiers_reach_the_handler():
    let t = compose_test:
        ModifierClicks()
    t.click("pick", modifiers="shift+cmd")
    t.advance()
    assert t.find_text("mods='shift+cmd'"), t.dump()
    t.click("pick")
    t.advance()
    assert t.find_text("mods=''"), t.dump()
    t.dispose()


@composable
def Styled():
    Column(Modifier().width(120)):
        Text("0123456789 0123456789 0123456789", style=TextStyle(mono=True, nowrap=True))
        Text("0123456789 0123456789 0123456789")


def test_nowrap_text_stays_on_one_line():
    let t = compose_test:
        Styled()
    let one = t.rect_of("0123456789 0123456789 0123456789")
    assert one[3] < 30.0, f"a single line: {one}"
    assert one[2] <= 120.0, "and no wider than its column"
    t.dispose()


def test_chord_names():
    assert chord_of_text("\n") == "enter"
    assert chord_of_text("\x1b") == "escape"
    assert chord_of_text("\x08") == "backspace"
    assert chord_of_text("X") == "shift+x"
    assert chord_of_text("j") == "j"
    assert chord_of_text(" ") == "space"


frozen data class Entry:
    id: int
    left: str
    right: str


@composable
def Table():
    let entries = state_list([Entry(1, "a", "b"), Entry(2, "c", "d")])
    Column:
        entries.each(key=lambda entry: entry.id):
            let entry = it
            Row:
                Text(entry.left)
                Text(entry.right)
        Button("swap"):
            entries[0] = Entry(2, "c", "d")
            entries[1] = Entry(1, "a", "b")


def test_a_key_covers_the_group_not_what_is_nested_in_it():
    # two texts inside one keyed row must not both carry the row's key
    let t = compose_test:
        Table()
    assert t.all_text() == ("a", "b", "c", "d", "swap"), t.dump()
    let first_row_before = t.rect_of("a")
    t.click("swap")
    t.advance()
    assert t.all_text() == ("c", "d", "a", "b", "swap"), t.dump()
    assert t.rect_of("c")[:2] == first_row_before[:2], "the rows were reconciled by key"
    assert "key=1" in t.dump() and "key=2" in t.dump()
    t.dispose()


@composable
def Appearance():
    Text(f"appearance {system_theme.value}")


def test_the_system_theme_is_a_state_a_composition_follows():
    let t = compose_test:
        Appearance()
    assert t.find_text("appearance light")
    system_theme.value = "dark"
    t.advance()
    assert t.find_text("appearance dark"), t.dump()
    system_theme.value = "light"
    t.advance()
    assert t.find_text("appearance light")
    t.dispose()


@composable
def Clicky():
    let hits = state(0)
    let last = state("")

    def handle(chord: str) -> bool:
        last.value = chord
        return True

    on_key(handle)
    Column:
        Text(f"hits {hits.value} last {last.value!r}")
        Button("hit"):
            hits.value += 1


def test_window_events_reach_the_runtime_and_the_appearance_needs_none():
    let events = WindowEvents()
    events.handle([(8, 0.0, 0.0, -1, "dark"), (5, 800.0, 600.0, -1, "")])
    assert system_theme.value == "dark", "the appearance arrives before the first frame"
    system_theme.value = "light"
    let t = compose_test:
        Clicky()
    events.runtime = t.runtime
    let handler = t.core.find_text("hit")
    assert handler is not None
    let idx = t.core.pointer(2, handler[1] + 1.0, handler[2] + 1.0)[3]
    events.handle([(1, 0.0, 0.0, idx, ""), (2, 0.0, 0.0, idx, "")])
    events.handle([(1, 0.0, 0.0, idx, ""), (2, 0.0, 0.0, -1, "")])
    events.handle([(7, 0.0, 0.0, -1, "cmd+k"), (4, 0.0, 0.0, -1, "\x1b"), (8, 0.0, 0.0, -1, "dark")])
    t.advance()
    assert t.find_text("hits 1 last 'escape'"), t.dump()
    assert system_theme.value == "dark"
    system_theme.value = "light"
    t.dispose()


@composable
def Aligned():
    Column:
        Row(Modifier().height(40).fill_max_width(), alignment=Alignment.Center):
            Text("centred")
            Text("tall", Modifier().height(30))
        Row(Modifier().height(40).fill_max_width()):
            Text("start")


def test_a_row_centres_its_children_across_itself():
    let t = compose_test:
        Aligned()
    let centred = t.rect_of("centred")
    let start = t.rect_of("start")
    assert centred[1] > 0.0, f"the centred text was moved down: {t.dump()}"
    assert abs((centred[1] - 0.0) - (40.0 - centred[1] - centred[3])) < 1.0, "equal space above and below"
    assert start[1] == 40.0, "the second row starts where the first ends, with its text at the top"
    t.dispose()


let ZERO = Dp(0.0)
let SELECTED = Color(204, 238, 255)
let PLAIN = Color(255, 255, 255)


@composable
def Bubble(rows: (*: str), selected: (*: str)):
    Column:
        keyed(rows).each_indexed(key=lambda name: name):
            let row = it
            let chosen = row.item in selected
            let above = row.index > 0 and rows[row.index - 1] in selected
            let below = row.index + 1 < len(rows) and rows[row.index + 1] in selected
            let radius = ZERO if not chosen else Dp(8.0)
            Text(
                row.item,
                Modifier()
                .fill_max_width()
                .height(20)
                .rounded_corners(ZERO if above else radius, ZERO if above else radius, ZERO if below else radius, ZERO if below else radius)
                .background(SELECTED if chosen else PLAIN),
            )


def test_each_indexed_gives_a_run_of_rows_one_outline():
    let t = compose_test(width=120, height=120):
        Bubble(("a", "b", "c"), ("a", "b"))
    assert t.all_text() == ("a", "b", "c"), t.dump()
    assert t.rect_of("a")[1] == 0.0 and t.rect_of("b")[1] == 20.0
    # the middle of the run keeps its square seam, the ends are rounded: the modifier of
    # each row is interned separately, so the tree shows three different chains
    let dump = t.dump()
    assert dump.count("mod=") >= 3, dump
    t.dispose()


@composable
def Fills():
    Column(Modifier().fill_max_size()):
        Text("stretched", Modifier().fill_max_width().background(Color(240, 240, 240)))


def test_a_resize_reflows_on_the_next_frame_without_recomposing():
    let t = compose_test(width=400, height=200):
        Fills()
    assert t.rect_of("stretched")[2] == 400.0
    let core: dynamic = t.core
    core.resize(700.0, 300.0, 1.0)
    t.advance()
    assert t.rect_of("stretched")[2] == 700.0, f"the resize reflowed: {t.dump()}"
    assert t.recompositions(Fills) == 1, "and nothing had to recompose for it"
    t.dispose()


@composable
def Menus():
    let menu = state((0.0, 0.0))
    let shown = state(False)
    let picked = state("")
    let tip = state(False)
    Column(Modifier().size(300, 200)):
        Text(f"picked {picked.value!r}")
        Text(
            "right click me",
            Modifier().fill_max_width().height(40).on_secondary(lambda: (menu.set(input_position()), shown.set(True)).1),
        )
        Text("hover me", Modifier().height(30).hoverable(lambda (entered: bool): tip.set(entered)))
        if tip.value:
            Text("a tooltip")
        if shown.value:
            let at = menu.value
            Popup(Dp(at.0), Dp(at.1)):
                Column(Modifier().background(Color(250, 250, 250)).border(1, Color(200, 200, 200)).padding(4)):
                    Text("cut", Modifier().clickable(lambda: (picked.set("cut"), shown.set(False)).1))
                    Text("copy", Modifier().clickable(lambda: (picked.set("copy"), shown.set(False)).1))


def test_a_right_click_opens_a_popup_that_is_hit_before_what_it_covers():
    let t = compose_test(width=300, height=200):
        Menus()
    assert t.find_text("picked ''")
    assert not t.find_text("cut"), "no menu until it is asked for"
    t.right_click("right click me")
    t.advance()
    assert t.find_text("cut") and t.find_text("copy"), t.dump()
    # the menu opened where the pointer was, and is painted over the row it covers
    let menu = t.rect_of("cut")
    let row = t.rect_of("right click me")
    assert menu[1] >= row[1], f"the menu is at the pointer: {menu} {row}"
    t.click("cut")
    t.advance()
    assert t.find_text("picked 'cut'"), t.dump()
    assert not t.find_text("copy"), "the menu closed"
    t.dispose()


@composable
def KeyedPopups():
    """a keyed menu holding a group of its own. the key belongs to the popup: a popup opens a
    container like every other one, and a key marks a group's own children and nothing nested
    in them"""
    let open = state("a")
    Column(Modifier().size(300, 200)):
        Text(f"open {open.value}")
        Button("swap", on_click=lambda: open.set("b" if open.value == "a" else "a"))
        keyed((open.value,)).each(key=lambda name: name):
            let name = it
            Popup(Dp(10.0), Dp(50.0)):
                Column():
                    Text(f"{name} first")
                    Text(f"{name} second")


def test_a_keyed_popup_does_not_key_its_own_children():
    let t = compose_test(width=300, height=200):
        KeyedPopups()
    assert t.find_text("a first") and t.find_text("a second"), t.dump()
    let keyed_lines = [line.strip() for line in t.dump().splitlines() if "key=" in line]
    assert keyed_lines == ['Popup key="a" [10,50 57x36] at=10,50'], \
        f"the key is the popup's alone; the group inside it is not keyed:\n{t.dump()}"
    t.click("swap")
    t.advance()
    assert t.find_text("b first") and t.find_text("b second"), t.dump()
    assert not t.find_text("a first") and not t.find_text("a second"), t.dump()
    t.dispose()


@composable
def Dismissed():
    """a layer that wants to know about a press outside it, over a button that wants the
    press: closing a menu and doing what the click was aimed at are one gesture. the order
    they were answered in is written into the tree, which is where a test can read it"""
    let order = state("")
    Column(Modifier().size(200, 100)):
        Text(f"order:{order.value}")
        Text(
            "outside",
            Modifier().height(40).fill_max_width().dismiss(lambda: order.set(order.value + " dismiss")),
        )
        Button("go", on_click=lambda: order.set(order.value + " click"))


def test_the_harness_answers_a_click_in_the_order_the_window_does():
    """the window drains the core after every pointer event and hands the batch over in
    order, so a dismiss the press set off is answered before the release. the harness
    synthesises both halves of the gesture itself and has to keep that order, or a test
    passes on a sequence the application never sees"""
    let t = compose_test(width=200, height=100):
        Dismissed()
    t.click("go")
    t.advance()
    assert t.find_text("order: dismiss click"), f"the harness:\n{t.dump()}"

    # the same gesture through the window's own path: the core's queue drained after each
    # pointer event, the whole batch handed to `WindowEvents` in one go
    let w = compose_test(width=200, height=100):
        Dismissed()
    let box = w.rect_of("go")
    let cx = box.0 + box.2 / 2.0
    let cy = box.1 + box.3 / 2.0
    var batch: list[(int, float, float, int, str)] = [w.core.pointer(1, cx, cy)]
    batch += w.core.take_events()
    batch.append(w.core.pointer(2, cx, cy))
    batch += w.core.take_events()
    let events = WindowEvents()
    events.runtime = w.runtime
    events.handle(batch)
    w.advance()
    assert w.find_text("order: dismiss click"), f"the window:\n{w.dump()}"
    t.dispose()
    w.dispose()


private def chain_of(which: str) -> Modifier:
    """a chain of `which`, built fresh — the closure inside it is a new object every call,
    which is exactly the case interning has to survive"""
    match which:
        case "clickable":
            return Modifier().clickable(lambda: None)
        case "secondary":
            return Modifier().on_secondary(lambda: None)
        case "hoverable":
            return Modifier().hoverable(lambda (over: bool): None)
        case "draggable":
            return Modifier().draggable(lambda (phase: str): None)
        case "dismiss":
            return Modifier().dismiss(lambda: None)
        case "drop_target":
            return Modifier().drop_target(lambda (what: str): None)
        case _:
            return Modifier().focus_region(lambda: None)


def test_a_chain_carrying_a_handler_is_interned_once_however_often_it_recomposes():
    """a modifier holding a handler index is interned by its encoded ops: the index is
    recycled, so the ops repeat where the value — a new closure every recomposition — does
    not. interning one by value mints an id per frame, here and in the core, and neither
    table is ever pruned"""
    for which in ("clickable", "secondary", "hoverable", "draggable", "dismiss", "drop_target", "focus_region"):
        let name = which
        let t = compose_test(width=200, height=100):
            let n = state(0)
            Column():
                Text(f"n = {n.value}")
                Text("marked", chain_of(name))
                Button("bump", on_click=lambda: n.set(n.value + 1))
        # a few runs to settle: handler indices are handed back and taken again, so the
        # first recomposition can pick up a different one and intern a second chain
        for _ in range(4):
            t.click("bump")
            t.advance()
        let settled = len(t.runtime.modifier_ids)
        for _ in range(8):
            t.click("bump")
            t.advance()
        let minted = len(t.runtime.modifier_ids) - settled
        assert minted == 0, f"{name}: {minted} more ids over eight further recompositions"
        t.dispose()


def test_hovering_reports_entering_and_leaving():
    let t = compose_test(width=300, height=200):
        Menus()
    assert not t.find_text("a tooltip")
    t.hover("hover me")
    t.advance()
    assert t.find_text("a tooltip"), t.dump()
    assert t.hover_target() >= 0
    t.hover_at(299.0, 199.0)
    t.advance()
    assert not t.find_text("a tooltip"), "leaving takes it away"
    assert t.hover_target() == -1
    t.dispose()


@composable
def Splitter():
    let width = state(120.0)
    let phase = state("")
    let start = state(0.0)

    def drag(step: str):
        if step == "start":
            start.value = input_position().0 - width.value
        elif step == "move":
            width.value = max(40.0, input_position().0 - start.value)
        phase.value = step

    Column:
        Text(f"width {int(width.value)} {phase.value}")
        Row:
            Spacer(Modifier().width(Dp(width.value)).height(20).background(Color(230, 230, 230)))
            Text("handle", Modifier().width(10).height(20).draggable(drag))


def test_a_drag_follows_the_pointer_and_reports_its_steps():
    let t = compose_test(width=400, height=200):
        Splitter()
    assert t.find_text("width 120 "), t.dump()
    t.drag("handle", 60.0, 0.0)
    t.advance()
    assert t.find_text("width 180 end"), f"the handle followed the pointer: {t.dump()}"
    # dragging back past the minimum stops there
    t.drag("handle", -400.0, 0.0)
    t.advance()
    assert t.find_text("width 40 end"), t.dump()
    t.dispose()


@composable
def Watching(stopped: State[str]):
    """a composition holding something that has to be let go of — a subscription, a watcher —
    which is what a window closing has to run the cleanup of"""
    disposable_effect(0):
        it.on_dispose(lambda: stopped.set("stopped"))
    Text("watching")


@composable
def Sized():
    let size = window_size().value
    Text(f"window {int(size.0)}x{int(size.1)}")


def test_the_window_size_is_state_the_layout_can_read():
    let t = compose_test(width=640, height=480):
        Sized()
    assert t.find_text("window 640x480"), t.dump()
    let events = WindowEvents()
    events.runtime = t.runtime
    events.handle([(5, 900.0, 700.0, -1, "")])
    t.advance()
    assert t.find_text("window 900x700"), t.dump()
    t.dispose()


def test_each_window_has_a_size_of_its_own():
    """`open_window` opens a second window of its own size in the same process. a pane in one
    of them must not reflow because the other was dragged wider, so the size is one state per
    composition rather than one per process"""
    let one = compose_test(width=640, height=480):
        Sized()
    let two = compose_test(width=300, height=200):
        Sized()
    assert one.find_text("window 640x480") and two.find_text("window 300x200"), two.dump()

    let events = WindowEvents()
    events.runtime = two.runtime
    events.handle([(5, 900.0, 700.0, -1, "")])
    one.advance()
    two.advance()
    assert two.find_text("window 900x700"), two.dump()
    assert one.find_text("window 640x480"), f"the other window did not move:\n{one.dump()}"
    one.dispose()
    two.dispose()


def test_a_window_that_closes_disposes_its_composition():
    """closing a second window ends its composition: the cleanups of every
    `disposable_effect` in it run, rather than waiting for the process to end"""
    let stopped = State("running")
    let t = compose_test(width=200, height=100):
        Watching(stopped)
    assert any(runtime === t.runtime for runtime in live_runtimes)
    let events = WindowEvents()
    events.runtime = t.runtime
    events.handle([(6, 0.0, 0.0, -1, "")])
    assert stopped.value == "stopped", f"the effect's cleanup ran: {stopped.value}"
    assert events.runtime is None, "and the window let go of the runtime"
    assert all(runtime !== t.runtime for runtime in live_runtimes)


@composable
def Fields():
    let plain = state("")
    let dressed = state("dark")
    Column:
        TextField(plain.value, placeholder="plain"):
            plain.value = it
        TextField(
            dressed.value,
            Modifier().rounded(8).background(Color(24, 28, 34)).border(1, Color(52, 60, 72)),
            placeholder="dressed",
            style=TextStyle(Dp(13.0), Color(230, 233, 239)),
        ):
            dressed.value = it


def test_a_text_field_takes_a_style_and_its_own_decoration():
    let t = compose_test(width=400, height=200):
        Fields()
    assert t.find_text("plain") and t.find_text("dark"), t.dump()
    let core: dynamic = t.core
    core.paint()
    width, height = core.pixel_size()
    let pixels: bytes = core.pixels()

    def at(x: int, y: int) -> (int, int, int):
        let offset = (y * width + x) * 4
        return (pixels[offset], pixels[offset + 1], pixels[offset + 2])

    let plain = t.rect_of("plain")
    let dressed = t.rect_of("dark")
    # a point inside each field, past its text: the undecorated one keeps the white box the
    # framework draws, the decorated one is painted in the colours it was given
    assert at(int(plain[0] + plain[2] - 10.0), int(plain[1] + plain[3] / 2.0)) == (255, 255, 255)
    assert at(int(dressed[0] + dressed[2] - 10.0), int(dressed[1] + dressed[3] / 2.0)) == (24, 28, 34)
    t.dispose()


@composable
def Selectable():
    let copied = state("")

    def keys(chord: str) -> bool:
        if chord == "cmd+c":
            copied.value = selected_text()
            return True
        return False

    on_key(keys)
    Column(Modifier().selectable(Color(180, 205, 250))):
        Text("first line")
        Text("second line")
        Text("third line")
    Text(f"copied {copied.value!r}")


def test_text_is_selected_by_sweeping_and_read_from_a_key_handler():
    let t = compose_test(width=300, height=200):
        Selectable()
    assert t.selected_text() == ""
    assert t.select("first line", "second line") == "first line\nsecond line"
    # a handler reads what is selected, which is how a copy command gets it
    assert t.press("cmd+c")
    t.advance()
    assert t.find_text("copied 'first line\\nsecond line'"), t.dump()
    # a click elsewhere in the same text clears it
    t.click_at(1.0, 1.0)
    assert t.selected_text() == ""
    t.dispose()


@composable
def Paragraph(box: State[str]):
    TextField(box.value, Modifier().fill_max_width().multiline(), placeholder="say something"):
        box.value = it


def test_a_field_of_several_lines_takes_a_line_break():
    let text = State("")
    let t = compose_test(width=300, height=200):
        Paragraph(text)
    t.type_into("say something", "first")
    t.advance()
    let one_line = t.rect_of("first")
    # Enter is a line break in a field that takes several, and the field grows to hold it
    t.edit_key("Enter")
    t.advance()
    t.type_more("second")
    t.advance()
    assert text.value == "first\nsecond", repr(text.value)
    let two_lines = t.rect_of("first\nsecond")
    assert two_lines.3 > one_line.3, (one_line, two_lines)
    t.dispose()


def test_a_field_keeps_the_caret_in_sight_and_takes_the_usual_shortcuts():
    """text longer than the box used to be typed off the end of it, and the keys everyone
    else has for moving about in it went to the window instead of into the field"""
    let text = State("")
    let t = compose_test(width=300, height=200):
        Column(Modifier().fill_max_size()):
            TextField(text.value, Modifier().width(120), placeholder="a short box"):
                text.value = it
    t.type_into("a short box", "the quick brown fox jumps over it")
    t.advance()
    t.core.paint()
    let placed = t.caret()
    assert placed is not None, "the field has focus"
    assert placed.0 == len(text.value), "the caret is at the end of what was typed"
    assert placed.2 > 0.0, f"and the field scrolled to keep it in sight: {placed}"

    # ⌘← is the start of the line, and the field scrolls back with it — over a few frames,
    # since it eases rather than jumping, so this paints until it has arrived
    assert t.edit_chord("Left", meta=True)
    t.advance()
    var home = t.caret()
    for _ in range(80):
        t.core.paint()
        home = t.caret()
        if home is not None and home.2 == 0.0:
            break
        time.sleep(0.01)
    assert home is not None and home.0 == 0, home
    assert home.2 == 0.0, f"the field scrolled back to the start: {home}"

    # ⌥→ moves a word at a time, and shift keeps the far end where it was
    assert t.edit_chord("Right", alt=True)
    let word = t.caret()
    assert word is not None and word.0 == 3, f"past `the`: {word}"
    assert t.edit_chord("Right", alt=True, shift=True)
    let picked = t.caret()
    assert picked is not None and picked.1 == 3 and picked.0 == 9, f"`quick` is selected: {picked}"

    # typing replaces what is selected
    t.type_more("X")
    t.advance()
    assert text.value.startswith("theX brown"), repr(text.value)

    # a chord the field has no use for is left for the window
    assert not t.edit_chord("R", meta=True), "the field leaves ⌘R alone"
    t.dispose()


def test_a_container_spaces_itself_and_a_press_shows_on_what_was_pressed():
    """a gap written on the container is the space between each pair of its children, so the
    number appears once instead of at every join; a press wash is the only sign a click has
    landed before whatever it sets off comes back"""
    let pressed = State(0)
    let t = compose_test(width=200, height=200):
        Column(Modifier().fill_max_width().gap(Dp(10.0))):
            Text("one", Modifier().height(Dp(20.0)))
            Text("two", Modifier().height(Dp(20.0)).pressed(Color(255, 0, 0)).clickable(lambda: pressed.set(pressed.value + 1)))
            Text("three", Modifier().height(Dp(20.0)))
    let one = t.rect_of("one")
    let two = t.rect_of("two")
    let three = t.rect_of("three")
    assert two.1 - (one.1 + one.3) == 10.0, (one, two)
    assert three.1 - (two.1 + two.3) == 10.0, (two, three)

    # a weighted child is handed what is left *after* the gaps, so a row that spaces itself
    # does not push its last control off its own edge
    let spaced = compose_test(width=200, height=60):
        Row(Modifier().fill_max_width().gap(Dp(10.0))):
            Text("a", Modifier().width(Dp(40.0)))
            Spacer(weight(1.0))
            Text("b", Modifier().width(Dp(40.0)))
    let last = spaced.rect_of("b")
    assert last.0 + last.2 <= 200.0, f"the row stayed inside the window: {last}"
    spaced.dispose()

    # the press paints while the pointer is down and stops when it comes up
    _ = t.core.pointer(1, two.0 + 2.0, two.1 + 2.0)
    t.core.paint()
    _ = t.core.pointer(2, two.0 + 2.0, two.1 + 2.0)
    t.click("two")
    t.advance()
    assert pressed.value == 1, "and the click still lands"
    t.dispose()


def test_a_wide_container_pans_sideways_rather_than_cutting_its_content_off():
    """a line wider than the viewport had nowhere to go: it was clipped at the edge, with
    nothing to say so. a wide container lays its content out at the width the content wants"""
    let t = compose_test(width=200, height=100):
        Scroll(Modifier().fill_max_size().scrollbar(Color(0, 0, 0)), wide=True):
            Text("a line far wider than two hundred logical pixels could ever hope to be", Modifier())
            Text("short", Modifier())
    let wide = t.rect_of("a line far wider than two hundred logical pixels could ever hope to be")
    assert wide.2 > 200.0, f"the text kept its own width: {wide}"
    let before = wide.0
    # the wheel sideways moves it, and stops at the end of the content
    assert t.core.scroll(100.0, 50.0, 0.0, 120.0), "it panned"
    let after = t.rect_of("a line far wider than two hundred logical pixels could ever hope to be")
    assert after.0 < before, (before, after)
    # and back
    _ = t.core.scroll(100.0, 50.0, 0.0, -400.0)
    assert t.rect_of("a line far wider than two hundred logical pixels could ever hope to be").0 == before
    t.dispose()


def note(into: list[str], what: str):
    """a handler writing to a list the composition never reads: the composition cannot
    observe it, which is the point — it is the test that reads it, afterwards"""
    into.append(what)


def test_a_drag_says_what_it_was_let_go_on():
    """`draggable` says where the pointer is and nothing about what is under it, so a drag
    that moves a thing had nowhere to put it. a drop target is told when a drag comes over
    it, when it leaves, and when it is let go there"""
    said: list[str] = []
    let t = compose_test(width=200, height=200):
        Column(Modifier().fill_max_size()):
            Text("handle", Modifier().fill_max_width().height(Dp(40.0)).draggable(lambda (what: str): None))
            Text("here", Modifier().fill_max_width().height(Dp(40.0)).drop_target(lambda (what: str): note(said, f"here:{what}")))
            Text("there", Modifier().fill_max_width().height(Dp(40.0)).drop_target(lambda (what: str): note(said, f"there:{what}")))
    let handle = t.rect_of("handle")
    let here = t.rect_of("here")
    let there = t.rect_of("there")
    _ = t.core.pointer(1, handle.0 + 5.0, handle.1 + 5.0)
    t.deliver()
    # a press that has not travelled is still a press: the drag starts once it moves
    _ = t.core.pointer(3, here.0 + 5.0, here.1 + 5.0)
    t.deliver()
    _ = t.core.pointer(3, there.0 + 5.0, there.1 + 5.0)
    t.deliver()
    _ = t.core.pointer(2, there.0 + 5.0, there.1 + 5.0)
    t.deliver()
    t.advance()
    assert said == ["here:over", "here:leave", "there:over", "there:drop"], said
    t.dispose()


def test_a_lazy_list_composes_only_the_rows_in_view():
    """`Scroll` composes every child, which is why a client on this framework grows constants
    like *draw twelve hundred lines and then stop*. a lazy column emits the window it can see
    and a spacer standing in for the rest"""
    let t = compose_test(width=200, height=100):
        LazyColumn(1000, Dp(20.0), Modifier().fill_max_size()):
            let index = it
            Text(f"row {index}", Modifier().fill_max_width().height(Dp(20.0)))
    t.advance()
    let shown = [line for line in t.all_text() if line.startswith("row ")]
    assert len(shown) < 40, f"only what is in view, not a thousand rows: {len(shown)}"
    assert "row 0" in shown, shown[:4]
    assert "row 900" not in shown

    # scrolling down composes a different window of them, and the list is still a thousand tall
    _ = t.core.scroll(100.0, 50.0, 4000.0)
    t.deliver()
    t.advance()
    t.advance()
    let later = [line for line in t.all_text() if line.startswith("row ")]
    assert later and later != shown, (shown[:3], later[:3])
    assert "row 0" not in later, later[:4]
    t.dispose()


def test_a_press_says_which_part_of_the_window_the_keyboard_belongs_to():
    """`on_key` offers a chord to the deepest scope first, which is not the same as knowing
    where you are. a focus region is told when a press lands in it, so `j` can move a list on
    one side and do something else on the other"""
    said: list[str] = []
    let t = compose_test(width=200, height=200):
        Column(Modifier().fill_max_size()):
            Text("left", Modifier().fill_max_width().height(Dp(60.0)).focus_region(lambda: note(said, "left")))
            Text("right", Modifier().fill_max_width().height(Dp(60.0)).focus_region(lambda: note(said, "right")))
    def press_on(label: str):
        let box = t.rect_of(label)
        _ = t.core.pointer(1, box.0 + 5.0, box.1 + 5.0)
        t.deliver()
        _ = t.core.pointer(2, box.0 + 5.0, box.1 + 5.0)
        t.deliver()

    press_on("left")
    t.advance()
    press_on("right")
    t.advance()
    # and pressing the same one again says nothing: it already had the keyboard
    press_on("right")
    t.advance()
    assert said == ["left", "right"], said
    t.dispose()


def test_a_canvas_draws_an_arbitrary_shape():
    """circles, lines and boxes are three shapes. anything else — an arrow, a chevron, a
    mark of any kind — needed a path, and there was not one"""
    let t = compose_test(width=100, height=100):
        Canvas(Modifier().fill_max_size()):
            path(((10.0, 10.0), (90.0, 10.0), (50.0, 90.0)), Color(255, 0, 0))
            path(((20.0, 20.0), (80.0, 20.0), (50.0, 70.0)), Color(0, 0, 255), stroke=Dp(2.0))
    let core: dynamic = t.core
    core.paint()
    width, height = core.pixel_size()
    let pixels: bytes = core.pixels()

    def at(x: int, y: int) -> (int, int, int):
        let offset = (y * width + x) * 4
        return (pixels[offset], pixels[offset + 1], pixels[offset + 2])

    let scale = width // 100
    # inside the filled triangle, and outside every shape
    let inside = at(50 * scale, 30 * scale)
    let outside = at(5 * scale, 95 * scale)
    assert inside != outside, (inside, outside)
    assert outside[0] > 200 and outside[1] > 200, outside
    t.dispose()


def test_a_thing_you_cannot_see_is_not_a_thing_you_can_click():
    """painting stopped at a scroll container's edge and hit testing did not, so a button
    scrolled out of view was invisible and still answered a press"""
    clicked: list[str] = []
    let t = compose_test(width=200, height=100):
        Scroll(Modifier().fill_max_size()):
            Text("near", Modifier().fill_max_width().height(Dp(60.0)).clickable(lambda: note(clicked, "near")))
            Text("far", Modifier().fill_max_width().height(Dp(60.0)).clickable(lambda: note(clicked, "far")))
            Text("further", Modifier().fill_max_width().height(Dp(60.0)).clickable(lambda: note(clicked, "further")))
    let out_of_view = t.rect_of("further")
    assert out_of_view.1 > 100.0, f"it is below the viewport: {out_of_view}"
    assert t.core.hit_test(out_of_view.0 + 5.0, out_of_view.1 + 5.0) < 0, "and nothing there answers"
    t.click("near")
    t.advance()
    assert clicked == ["near"], clicked
    t.dispose()


def test_a_node_says_what_the_pointer_should_look_like_over_it():
    let t = compose_test(width=200, height=100):
        Column(Modifier().fill_max_size().cursor(CursorShape.Hand)):
            Text("grab me", Modifier().cursor(CursorShape.ColumnResize))
    let where = t.rect_of("grab me")
    assert t.cursor_at(where.0 + 1.0, where.1 + 1.0) == 3, "the text's own shape"
    assert t.cursor_at(190.0, 90.0) == 1, "the column's, everywhere else"
    t.dispose()


def test_a_run_of_a_line_can_be_painted_behind_without_splitting_it_up():
    """word-level highlighting inside a diff line. splitting the line into a text node per
    word would paint it, and would also make a sweep of the pointer copy one word a line, so
    the run is a property of the one node instead"""
    let t = compose_test(width=300, height=80):
        Column(Modifier().fill_max_size().background(Color(255, 255, 255))):
            Text(
                "aaaaaaaaaabbbbbbbbbb",
                Modifier().mark(10, 20, Color(255, 0, 0)),
                style=TextStyle(Dp(13.0), Color(0, 0, 0), False, True),
            )
    let core: dynamic = t.core
    core.paint()
    width, height = core.pixel_size()
    let pixels: bytes = core.pixels()

    def at(x: int, y: int) -> (int, int, int):
        let offset = (y * width + x) * 4
        return (pixels[offset], pixels[offset + 1], pixels[offset + 2])

    let line = t.rect_of("aaaaaaaaaabbbbbbbbbb")
    let middle = int(line.1 + line.3 / 2.0)
    # the second half is behind the mark and the first half is not: monospace, so the
    # halves are the same width
    assert at(int(line.0 + line.2 * 0.75), middle)[0] == 255
    assert at(int(line.0 + line.2 * 0.75), middle)[1] == 0
    assert at(int(line.0 + line.2 * 0.25), middle)[1] == 255, "the untouched half is still white"
    t.dispose()


@composable
def Labelled(text: str):
    Text(text, Modifier())


def test_a_scope_invalidated_before_it_was_ever_committed_restarts_its_parent():
    """a scope the core has not seen yet has no group of its own to replace: what it emitted
    is still inside its parent's records. offering the core a range over it — which is what
    invalidating it in the frame that made it used to do — is a commit it cannot apply"""
    let t = compose_test(width=200, height=100):
        Column(Modifier().fill_max_size()):
            Labelled("here")
    let root = t.runtime.root
    assert root is not None
    # the text's own scope, made and committed by the frame above
    let scopes = [scope for scope in t.runtime.scopes.values() if scope.id != 0]
    assert scopes, "the root made at least one scope"
    let child = scopes[-1]
    assert child.committed, "which the core has seen"
    # one that has not been committed is not asked to run on its own: its parent is
    child.committed = False
    child.dirty = False
    t.runtime.invalidate(child)
    assert not child.dirty, "the child was not queued"
    let up = child.parent
    assert up is not None and (up.dirty or up.parent is None), "its parent was, instead"
    t.dispose()


def test_a_run_of_a_line_can_be_drawn_in_a_colour_of_its_own():
    """syntax colouring inside one text node: the line stays one node, so a sweep of the
    pointer still copies it as a line"""
    let t = compose_test(width=300, height=80):
        Column(Modifier().fill_max_size().background(Color(255, 255, 255))):
            Text(
                "aaaaaaaaaabbbbbbbbbb",
                Modifier().tint(10, 20, Color(220, 0, 0)),
                style=TextStyle(Dp(13.0), Color(0, 0, 0), False, True),
            )
    let core: dynamic = t.core
    core.paint()
    width, height = core.pixel_size()
    let pixels: bytes = core.pixels()
    let line = t.rect_of("aaaaaaaaaabbbbbbbbbb")

    def reddest(from_x: float, to_x: float) -> (int, int, int):
        """the most coloured pixel of the glyphs in that stretch of the line"""
        best = (255, 255, 255)
        for x in range(int(line.0 + from_x), int(line.0 + to_x)):
            for y in range(int(line.1), int(line.1 + line.3)):
                let offset = (y * width + x) * 4
                let pixel = (pixels[offset], pixels[offset + 1], pixels[offset + 2])
                if pixel[0] - pixel[2] > best[0] - best[2]:
                    best = pixel
        return best

    let coloured = reddest(line.2 / 2.0, line.2)
    let plain = reddest(0.0, line.2 / 2.0)
    assert coloured[0] - coloured[2] > 60, f"the tinted half is red: {coloured}"
    assert plain[0] - plain[2] < 10, f"and the other half is not: {plain}"
    t.dispose()


def _png(width: int, height: int, pixel: (int, int, int)) -> bytes:
    """a png of one colour, written by hand: the tests draw one rather than carry a file"""
    import struct
    import zlib

    raw = bytearray()
    for _ in range(height):
        raw.append(0)
        for _ in range(width):
            raw.extend((pixel[0], pixel[1], pixel[2], 255))

    def chunk(kind: bytes, data: bytes) -> bytes:
        body = kind + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)

    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0))
        + chunk(b"IDAT", zlib.compress(bytes(raw), 6))
        + chunk(b"IEND", b"")
    )


def test_an_image_is_drawn_at_its_own_shape_inside_what_it_is_given():
    """a png the core decodes once and draws every frame: as big as it is, scaled down to fit,
    and never stretched — an image squeezed into a box is a lie about the file"""
    let data = _png(40, 20, (200, 30, 30))
    let t = compose_test(width=200, height=120):
        Column(Modifier().fill_max_size().background(Color(255, 255, 255))):
            let picture = remember(lambda: load_image(data))
            Image(picture, Modifier())
    let core: dynamic = t.core
    core.paint()
    width, height = core.pixel_size()
    let pixels: bytes = core.pixels()

    def at(x: int, y: int) -> (int, int, int):
        let offset = (y * width + x) * 4
        return (pixels[offset], pixels[offset + 1], pixels[offset + 2])

    # its own forty by twenty, since the window has room for it
    assert at(4, 4)[0] > 150 and at(4, 4)[1] < 90, f"the image is painted: {at(4, 4)}"
    assert at(4, 30) == (255, 255, 255), "and stops where it ends"
    assert at(60, 4) == (255, 255, 255)
    t.dispose()


def test_an_image_larger_than_its_room_is_scaled_down_and_keeps_its_shape():
    let data = _png(400, 200, (30, 160, 60))
    let t = compose_test(width=100, height=100):
        Column(Modifier().fill_max_size().background(Color(255, 255, 255))):
            let picture = remember(lambda: load_image(data))
            Image(picture, Modifier())
    let core: dynamic = t.core
    core.paint()
    width, height = core.pixel_size()
    let pixels: bytes = core.pixels()

    def at(x: int, y: int) -> (int, int, int):
        let offset = (y * width + x) * 4
        return (pixels[offset], pixels[offset + 1], pixels[offset + 2])

    # a hundred wide and, keeping two-to-one, fifty tall
    assert at(50, 25)[1] > 120, f"the middle of it: {at(50, 25)}"
    assert at(50, 70) == (255, 255, 255), "and nothing below where it ends"
    t.dispose()


def test_a_bar_along_one_edge_is_the_nodes_own():
    """what a selected row is marked with, without a spacer of its own inside every row"""
    let t = compose_test(width=200, height=60):
        Column(Modifier().fill_max_size().background(Color(255, 255, 255))):
            Text(
                "marked",
                Modifier().fill_max_width().height(Dp(30.0)).rule(Side.Leading, Dp(4.0), Color(0, 120, 255)),
            )
    let core: dynamic = t.core
    core.paint()
    width, height = core.pixel_size()
    let pixels: bytes = core.pixels()

    def at(x: int, y: int) -> (int, int, int):
        let offset = (y * width + x) * 4
        return (pixels[offset], pixels[offset + 1], pixels[offset + 2])

    assert at(1, 15) == (0, 120, 255), f"the bar is on the leading edge: {at(1, 15)}"
    assert at(3, 15) == (0, 120, 255), "four wide"
    assert at(6, 15) == (255, 255, 255), "and no wider"
    assert at(1, 45) == (255, 255, 255), "and only as tall as the node"
    t.dispose()
