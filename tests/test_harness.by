"""The headless harness against the real native core: composition, commit,
layout, hit testing and text editing end to end."""

from basedpython_ui import (
    composable, state, state_list, derived, keyed, on_key, input_modifiers, Column, Row, Text, Button, TextField,
    Checkbox, Modifier, Canvas, Layout, Scroll, TextStyle, MeasureScope, Constraints, Size, compose_test,
    chord_of_text,
)
from basedpython_ui.geometry import Dp, Color
from basedpython_ui.runtime import live_runtimes


@composable
def Counter(step: int = 1):
    let count = state(0)
    Column(Modifier().padding(8)):
        Text(f"count = {count.value}")
        Row:
            Button("+"):
                count.value += step
            Button("reset", enabled=count.value != 0):
                count.value = 0


def test_counter_end_to_end():
    let t = compose_test:
        Counter(step=2)
    assert t.find_text("count = 0")
    t.click("+")
    t.advance()
    assert t.find_text("count = 2"), t.dump()
    t.click("+")
    t.advance()
    assert t.find_text("count = 4"), t.dump()
    assert t.recompositions(Counter) == 3
    t.click("reset")
    t.advance()
    assert t.find_text("count = 0"), t.dump()
    t.dispose()


frozen data class Todo:
    id: int
    title: str
    done: bool = False


@composable
def Todos():
    let todos = state_list([Todo(1, "alpha"), Todo(2, "beta")])
    let draft = state("")
    let remaining = derived(lambda: sum(1 for t in todos if not t.done))
    Column:
        Text(f"{remaining.value} left")
        TextField(draft.value, placeholder="what needs doing?"):
            draft.value = it
        Button("add", enabled=draft.value != ""):
            todos.append(Todo(len(todos) + 1, draft.value))
            draft.value = ""
        todos.each_indexed(key=lambda todo: todo.id):
            let row = it
            Row:
                Checkbox(row.item.done):
                    todos[row.index] = Todo(row.item.id, row.item.title, it)
                Text(row.item.title)


def test_text_input_checkbox_and_keyed_rows():
    let t = compose_test:
        Todos()
    assert t.find_text("2 left") and t.find_text("alpha") and t.find_text("beta")
    t.type_into("what needs doing?", "gamma")
    t.advance()
    t.click("add")
    t.advance()
    assert t.find_text("gamma"), t.dump()
    assert t.find_text("3 left"), t.dump()
    t.dispose()


def flow(scope: MeasureScope, constraints: Constraints) -> Size:
    var x = 0.0
    var tallest = 0.0
    for i in range(scope.child_count):
        let size = scope.measure(i, constraints.loose())
        scope.place(i, x, 0.0)
        x += size.width
        tallest = max(tallest, size.height)
    return Size(x, tallest)


@composable
def Custom():
    Layout(flow):
        Text("one")
        Text("two")
    Canvas(Modifier().size(50, 20)):
        rect(0.0, 0.0, size.width, size.height, "#ff0000")


def test_custom_layout_and_canvas_run_through_the_core():
    let t = compose_test:
        Custom()
    assert t.find_text("one") and t.find_text("two"), t.dump()
    assert "canvas" in t.dump().lower(), t.dump()
    t.dispose()


private def line_of_text(path: str, needle: str) -> int:
    """The 1-based line of the one line containing `needle` in the file at `path`."""
    with open(path, encoding="utf-8") as handle:
        lines = handle.read().splitlines()
    hits = [index + 1 for index, line in enumerate(lines) if needle in line]
    assert len(hits) == 1, f"{needle!r} must appear exactly once in {path}, found it on lines {hits}"
    return hits[0]


def test_why_explains_the_counter_recomposition():
    let t = compose_test:
        Counter(step=2)
    runtime = t.runtime
    assert any(other === runtime for other in live_runtimes)
    t.click("+")
    t.advance()
    runs = t.why(Counter)
    assert [run.origin for run in runs] == ["first", "self"]
    reruns = [run for run in runs if run.origin != "first"]
    assert len(reruns) == 1 and len(reruns[0].causes) == 1
    run = reruns[0]
    cause = run.causes[0]
    assert cause.kind == "state" and cause.name == "count" and cause.old == 0 and cause.new == 2 and not cause.posted
    raw: dynamic = cause.raw
    generated: dynamic = run.raw[5]
    # the needles are spelled in two parts so that these lines do not match themselves
    assert raw[10] == generated and raw[11] == line_of_text(generated, "count.value" + " += step")
    by_file = cause.file
    by_line = cause.line
    assert by_file is not None and by_line is not None and by_file.endswith("tests/test_harness.by")
    # the .by line comes from out/_by_sourcemap.py: the lines of a hoisted handler block map
    # back to the handler's own lines, so the write is located on the line that wrote it
    assert by_line == line_of_text(by_file, "count.value" + " += step")
    # `co_firstlineno` of a decorated function is the line of its first decorator
    assert run.defined[0] == by_file and run.defined[1] == line_of_text(by_file, "def Counter" + "(step: int = 1):") - 1
    text = t.explain(since_frame=runtime.frames - 1)
    assert "count (state) set 0 → 2 at " in text and "Counter#" in text
    t.dispose()
    assert all(other !== runtime for other in live_runtimes)


def test_compose_test_is_a_context_manager():
    with compose_test(root=Counter) as t:
        runtime = t.runtime
        assert any(other === runtime for other in live_runtimes)
        t.click("+")
        t.advance()
        assert t.find_text("count = 1"), t.dump()
    assert all(other !== runtime for other in live_runtimes), "leaving the block disposed it"


def test_compose_test_without_tracing():
    let t = compose_test(trace=False):
        Counter(step=2)
    t.click("+")
    t.advance()
    assert t.find_text("count = 2"), t.dump()
    assert t.why(Counter) == () and t.runtime.trace is None


@composable
def Rows():
    let selected = state(0)

    def handle(chord: str) -> bool:
        if chord == "down":
            selected.value += 1
            return True
        if chord == "up":
            selected.value -= 1
            return True
        return False

    on_key(handle)
    Column(Modifier().size(200, 100)):
        Scroll(Modifier().fill_max_size()):
            keyed(range(10)).each(key=lambda i: i):
                let i = it
                Text(
                    f"row {i}",
                    Modifier().height(30).fill_max_width().reveal(i == selected.value).hover("#eeeeee").clickable(lambda: selected.set(i)),
                )


def test_scroll_container_wheel_reveal_hover_and_keys():
    let t = compose_test(width=200, height=100):
        Rows()
    assert t.find_text("row 0") and t.find_text("row 9"), t.dump()
    assert t.rect_of("row 9")[1] >= 100.0, "the last row starts below the viewport"
    assert t.scroll("row 1", 60.0)
    assert t.rect_of("row 0")[1] == -60.0 and t.scroll_offset() == 60.0, t.dump()
    assert not t.scroll("row 1", -1000.0) or t.scroll_offset() == 0.0
    t.hover("row 3")
    assert t.hovered_handler() >= 0, "a hoverable row reports its handler"
    for _ in range(5):
        assert t.press("down")
    t.advance()
    let y = t.rect_of("row 5")[1]
    assert 0.0 <= y and y + 30.0 <= 100.0, f"the selected row was scrolled into view: {t.dump()}"
    assert not t.press("left"), "an unbound chord is declined"
    assert t.rect_of("row 2")[1] < 0.0, "row 2 is scrolled out, so it cannot be clicked"
    t.click("row 4")
    t.advance()
    assert t.press("up") and t.press("up")
    t.advance()
    assert 0.0 <= t.rect_of("row 2")[1] <= 70.0, f"the selection went back to row 2 and revealed it: {t.dump()}"
    assert "Scroll" in t.dump()
    t.dispose()


@composable
def ModifierClicks():
    let seen = state("")
    Column:
        Button("pick"):
            seen.value = input_modifiers()
        Text(f"mods={seen.value!r}")


def test_click_modifiers_reach_the_handler():
    let t = compose_test:
        ModifierClicks()
    t.click("pick", modifiers="shift+cmd")
    t.advance()
    assert t.find_text("mods='shift+cmd'"), t.dump()
    t.click("pick")
    t.advance()
    assert t.find_text("mods=''"), t.dump()
    t.dispose()


@composable
def Styled():
    Column(Modifier().width(120)):
        Text("0123456789 0123456789 0123456789", style=TextStyle(mono=True, nowrap=True))
        Text("0123456789 0123456789 0123456789")


def test_nowrap_text_stays_on_one_line():
    let t = compose_test:
        Styled()
    let one = t.rect_of("0123456789 0123456789 0123456789")
    assert one[3] < 30.0, f"a single line: {one}"
    assert one[2] <= 120.0, "and no wider than its column"
    t.dispose()


def test_chord_names():
    assert chord_of_text("\n") == "enter"
    assert chord_of_text("\x1b") == "escape"
    assert chord_of_text("\x08") == "backspace"
    assert chord_of_text("X") == "shift+x"
    assert chord_of_text("j") == "j"
    assert chord_of_text(" ") == "space"


frozen data class Entry:
    id: int
    left: str
    right: str


@composable
def Table():
    let entries = state_list([Entry(1, "a", "b"), Entry(2, "c", "d")])
    Column:
        entries.each(key=lambda entry: entry.id):
            let entry = it
            Row:
                Text(entry.left)
                Text(entry.right)
        Button("swap"):
            entries[0] = Entry(2, "c", "d")
            entries[1] = Entry(1, "a", "b")


def test_a_key_covers_the_group_not_what_is_nested_in_it():
    # two texts inside one keyed row must not both carry the row's key
    let t = compose_test:
        Table()
    assert t.all_text() == ("a", "b", "c", "d", "swap"), t.dump()
    let first_row_before = t.rect_of("a")
    t.click("swap")
    t.advance()
    assert t.all_text() == ("c", "d", "a", "b", "swap"), t.dump()
    assert t.rect_of("c")[:2] == first_row_before[:2], "the rows were reconciled by key"
    assert "key=1" in t.dump() and "key=2" in t.dump()
    t.dispose()
