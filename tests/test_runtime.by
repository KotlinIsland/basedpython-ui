"""The composition runtime against a fake native core: no rust, no window.

Run with `by build --soundness none` then `python3.14 -m pytest out/tests -q`."""

import asyncio
import sys
import threading
from array import array

from basedpython_ui import (
    composable, state, state_list, state_dict, derived, key, keyed, launched_effect, disposable_effect, side_effect,
    ambient, provide, on_key, input_modifiers, Column, Row, Text, Button, Modifier, StateList, StateDict, State,
    Derived, Job,
)
from basedpython_ui.geometry import Dp   # literal conversions need the declaring module
from examples.counter import Counter as ImportedCounter   # a composable reached through a lazy-import proxy
from examples.theming import LIGHT, DARK, Theme, density   # values and an ambient reached through lazy-import proxies
from basedpython_ui.runtime import (
    Runtime, CompositionError, Handler, R_END, R_SCOPE, R_SCOPE_REF, R_TEXT, R_BUTTON, R_TEXTFIELD, R_COLUMN, R_ROW, R_BOX, R_LAYOUT,
    Trace, T_RUN, T_WRITE, T_FRAME, T_ERROR, T_REFUSED, live_runtimes, EffectSlot, Restart, SLOT_LAUNCHED,
)


frozen data class Rec:
    kind: int
    text: str
    handler: int
    a: int


class FakeCore:
    """Keeps the retained tree as one record list per scope group, exactly as
    the protocol describes; enough to answer `find_text` and to count what
    each commit carried."""

    init(self):
        self.groups: dict[int, list[Rec]] = {}
        self.commits: int = 0
        self.last_ranges: list[(int, int, int)] = []
        self.last_refs: int = 0
        self.layouts: int = 0
        self.disposed: list[int] = []

    def commit(self, ints: array[int], floats: array[float], strs: list[str], ranges: list[(int, int, int)], new_modifiers: list[(int, list[float])], new_styles: list[(int, float, float, int)]) -> list[int]:
        self.commits += 1
        self.last_ranges = list(ranges)
        self.last_refs = 0
        seen: set[int] = set()
        for scope_id, first, end in ranges:
            self.groups[scope_id] = self.parse(ints, strs, first, end, seen)
        # a group that no range mentions and that nothing references any more is gone
        reachable: set[int] = set()
        self.reach(0, reachable)
        gone = [sid for sid in self.groups if sid not in reachable]
        for sid in gone:
            del self.groups[sid]
        return gone

    private def parse(self, ints: array[int], strs: list[str], first: int, end: int, seen: set[int]) -> list[Rec]:
        stack: list[(int, list[Rec])] = [(-1, [])]
        i = first * 8            # ranges are record indices; records are 8 ints wide
        end_offset = end * 8
        while i < end_offset:
            kind = ints[i]
            text_idx = ints[i + 2]
            handler_idx = ints[i + 4]
            a = ints[i + 5]
            i += 8
            text = strs[text_idx] if text_idx >= 0 else ""
            match kind:
                case 1:
                    stack.append((a, []))
                case 0:
                    scope_id, records = stack.pop()
                    if scope_id >= 0:
                        self.groups[scope_id] = records
                        seen.add(scope_id)
                        stack[-1][1].append(Rec(R_SCOPE_REF, "", -1, scope_id))
                    else:
                        stack[-1][1].extend(records)
                        stack[-1][1].append(Rec(R_END, "", -1, 0))
                case 2:
                    self.last_refs += 1
                    stack[-1][1].append(Rec(R_SCOPE_REF, "", -1, a))
                case _:
                    if kind in (R_COLUMN, R_ROW, R_BOX, R_LAYOUT):
                        stack.append((-1, [Rec(kind, "", handler_idx, a)]))
                    else:
                        stack[-1][1].append(Rec(kind, text, handler_idx, a))
        while len(stack) > 1:
            scope_id, records = stack.pop()
            stack[-1][1].extend(records)
        return stack[0][1]

    private def reach(self, scope_id: int, out: set[int]):
        if scope_id in out:
            return
        out.add(scope_id)
        for rec in self.groups.get(scope_id, []):
            if rec.kind == R_SCOPE_REF:
                self.reach(rec.a, out)

    def records(self) -> list[Rec]:
        flat: list[Rec] = []
        self.flatten(0, flat)
        return flat

    private def flatten(self, scope_id: int, out: list[Rec]):
        for rec in self.groups.get(scope_id, []):
            if rec.kind == R_SCOPE_REF:
                self.flatten(rec.a, out)
            else:
                out.append(rec)

    def layout(self, measure: object):
        self.layouts += 1
    def paint(self): ...
    def resize(self, width: float, height: float, scale: float): ...
    def canvas_requests(self) -> list[(int, int, float, float)]:
        return []
    def set_canvas_commands(self, node_id: int, floats: array[float], strs: list[str]): ...
    def measure_child(self, index: int, min_w: float, max_w: float, min_h: float, max_h: float) -> (float, float):
        return (0.0, 0.0)
    def place_child(self, index: int, x: float, y: float): ...
    def hit_test(self, x: float, y: float) -> int:
        return -1
    @ignorable_return_value
    def pointer(self, kind: int, x: float, y: float) -> (int, float, float, int, str):
        return (kind, x, y, -1, "")
    @ignorable_return_value
    def key_text(self, text: str) -> (int, float, float, int, str)?:
        return None
    def find_text(self, text: str) -> (int, float, float, float, float)?:
        for rec in self.records():
            if rec.text == text:
                return (0, 0.0, 0.0, 0.0, 0.0)
        return None
    def all_text(self) -> list[str]:
        return [rec.text for rec in self.records() if rec.text]
    def field_handler(self, placeholder: str) -> int:
        return -1
    def scroll(self, x: float, y: float, dy: float) -> bool:
        return False
    def hovered_handler(self) -> int:
        return -1
    def hover_target(self) -> int:
        return -1
    def take_events(self) -> list[tuple[int, float, float, int, str]]:
        return []
    def cursor_at(self, x: float, y: float) -> int:
        return 0
    def selected_text(self) -> str:
        return ""
    def clear_selection(self): ...
    def first_scroll(self) -> tuple[int, float, float, float] | None:
        return None
    def dump(self) -> str:
        return "\n".join(f"{rec.kind} {rec.text!r} h={rec.handler} a={rec.a}" for rec in self.records())
    def node_count(self) -> int:
        return len(self.records())

    def handler_of(self, label: str) -> int:
        for rec in self.records():
            if rec.kind == R_BUTTON and rec.text == label:
                return rec.handler
        raise AssertionError(f"no button {label!r} in\n{self.dump()}")


def click(rt: Runtime, core: FakeCore, label: str):
    handler = rt.handlers[core.handler_of(label)]
    assert handler is not None
    _ = handler()


def compose(root: () -> None) -> (Runtime, FakeCore):
    core = FakeCore()
    errors: list[str] = []
    rt = Runtime(core, on_error=lambda error, where: errors.append(f"{where}: {error!r}"))
    rt.set_root(root)
    rt.frame()
    assert errors == [], errors
    return (rt, core)


# ------------------------------------------------------------------- tests


@composable
def Counter(step: int = 1):
    let count = state(0)
    Column(Modifier().padding(8)):
        Text(f"count = {count.value}")
        Row:
            Button("+"):
                count.value += step
            Button("reset", enabled=count.value != 0):
                count.value = 0


def test_counter_composes_recomposes_and_skips_the_untouched():
    rt, core = compose(lambda: Counter(2))  # ty: ignore[composable-outside-composition] -- the helper forwards the lambda to set_root
    assert core.all_text() == ["count = 0", "+", "reset"]
    assert rt.recompositions["Counter"] == 1
    click(rt, core, "+")
    assert not rt.is_idle()
    rt.frame()
    assert core.all_text() == ["count = 2", "+", "reset"]
    assert rt.recompositions["Counter"] == 2
    # only the counter's scope was re-emitted, and it is the only range
    assert len(core.last_ranges) == 1 and core.last_ranges[0][0] != 0
    rt.frame()
    assert core.commits == 2, "an idle frame commits nothing"


@composable
def Leaf(label: str):
    Text(label)


@composable
def Parent():
    let n = state(0)
    Column:
        Text(f"n = {n.value}")
        Leaf("a")
        Leaf("b")
        Button("bump"):
            n.value += 1


def test_every_frame_lays_out_so_a_resize_is_never_waited_out():
    # a window resize changes what the same tree measures to without recomposing anything,
    # so layout cannot be conditional on a commit
    rt, core = compose(Parent)
    assert core.layouts == 1
    rt.frame()
    assert core.commits == 1, "an idle frame commits nothing"
    assert core.layouts == 2, "but it still lays out"
    click(rt, core, "bump")
    rt.frame()
    assert (core.commits, core.layouts) == (2, 3)


def test_stable_children_are_skipped():
    rt, core = compose(Parent)
    assert rt.recompositions["Leaf"] == 2
    click(rt, core, "bump")
    rt.frame()
    assert rt.recompositions["Parent"] == 2
    assert rt.recompositions["Leaf"] == 2, "equal, stable arguments: the leaves were skipped"
    assert core.last_refs == 2, "the skipped leaves were emitted as SCOPE_REF"
    assert core.all_text() == ["n = 1", "a", "b", "bump"]


@composable
def Cell(name: str):
    let hits = state(0)
    Text(f"{name}:{hits.value}")
    Button(f"hit {name}"):
        hits.value += 1


@composable
def Conditional():
    let show = state(True)
    Column:
        if show.value:
            Cell("first")
        Cell("second")
        Button("toggle"):
            show.value = not show.value


def test_conditional_sibling_keeps_its_own_state():
    rt, core = compose(Conditional)
    click(rt, core, "hit second")
    rt.frame()
    assert "second:1" in core.all_text()
    click(rt, core, "toggle")
    rt.frame()
    assert core.all_text() == ["second:1", "hit second", "toggle"], "the surviving cell kept its state"
    click(rt, core, "toggle")
    rt.frame()
    assert core.all_text() == ["first:0", "hit first", "second:1", "hit second", "toggle"], "the re-added cell starts fresh"


frozen data class Item:
    id: int
    title: str


@composable
def ItemRow(item: Item):
    let clicks = state(0)
    Text(f"{item.title}#{clicks.value}")
    Button(f"click {item.title}"):
        clicks.value += 1


@composable
def Keyed():
    let items = state_list([Item(1, "one"), Item(2, "two"), Item(3, "three")])
    Column:
        items.each(key=lambda item: item.id):
            ItemRow(it)
        Button("drop first"):
            items.remove_at(0)


def test_keyed_children_survive_removal_of_a_sibling():
    rt, core = compose(Keyed)
    click(rt, core, "click two")
    rt.frame()
    assert "two#1" in core.all_text()
    click(rt, core, "drop first")
    rt.frame()
    assert core.all_text() == ["two#1", "click two", "three#0", "click three", "drop first"]
    assert rt.recompositions["ItemRow"] == 4, "3 initial runs + the clicked row; the survivors were matched by key, not re-created"


@composable
def Imported():
    let show = state(True)
    Column:
        if show.value:
            ImportedCounter()
        ImportedCounter(step=5)
        Button("toggle"):
            show.value = not show.value


def test_composables_called_through_import_proxies_keep_their_own_identity():
    # `from examples.counter import Counter` binds a proxy on python < 3.15: every call
    # through it passes the proxy's own `__call__` frame, which must not be the call site
    rt, core = compose(Imported)
    assert core.all_text()[:1] == ["count = 0"]
    click(rt, core, "+")             # the first "+" belongs to the first counter
    rt.frame()
    texts = core.all_text()
    assert texts.count("count = 1") == 1 and texts.count("count = 0") == 1
    click(rt, core, "toggle")
    rt.frame()
    assert "count = 1" not in core.all_text(), "the conditional counter is gone"
    assert "count = 0" in core.all_text(), "the second counter kept its own scope and state"
    click(rt, core, "+")
    rt.frame()
    assert "count = 5" in core.all_text(), "and it is still the step-5 counter"
    click(rt, core, "toggle")
    rt.frame()
    assert core.all_text()[:1] == ["count = 0"], "the re-added counter starts fresh"
    assert "count = 5" in core.all_text()


let palette = ambient(LIGHT)


@composable
def Themed2():
    let dark = state(False)
    provide(palette, DARK if dark.value else LIGHT):
        Text(f"spacing {palette.current.spacing.value}")
    Button("flip"):
        dark.value = not dark.value


def test_imported_values_enter_state_and_ambients_as_themselves():
    # `from examples.theming import LIGHT` binds a proxy on python < 3.15: the real theme is
    # what must be held, compared and provided
    rt, core = compose(Themed2)
    assert core.all_text() == ["spacing 8.0", "flip"]
    click(rt, core, "flip")
    rt.frame()
    assert core.all_text() == ["spacing 12.0", "flip"]
    cell: State[Theme] = State(LIGHT)
    assert type(cell.value).__name__ == "Theme"
    cell.value = DARK
    assert cell.value.spacing.value == 12.0
    items: StateList[Theme] = StateList([LIGHT])
    items.append(DARK)
    assert [t.spacing.value for t in items] == [8.0, 12.0]


@composable
def Dense():
    let scale = state(1.0)
    provide(density, scale.value):
        Text(f"density {density.current}")
    Button("denser"):
        scale.value += 1.0


def test_an_imported_ambient_is_provided_and_read_as_the_same_object():
    rt, core = compose(Dense)
    assert core.all_text() == ["density 1.0", "denser"]
    click(rt, core, "denser")
    rt.frame()
    assert core.all_text() == ["density 2.0", "denser"], "the provided value reached the reader through the proxy"


def test_derived_recomputes_once_per_change_and_only_notifies_on_change():
    evaluations: list[int] = [0]
    seen: list[str] = []

    @composable
    def Form():
        let name = state("")
        let email = state("")

        def check() -> str:
            evaluations[0] += 1  # ty: ignore[silent-mutation] -- deliberate in this test
            n = name.value
            e = email.value
            return "ok" if "@" in e and n else "incomplete"

        let status = derived(check)
        seen.append(status.value)  # ty: ignore[silent-mutation, unobservable-dependency] -- deliberate in this test
        Text(status.value)
        Button("name"):
            name.value = "ada"
        Button("email"):
            email.value = "ada@x"
        Button("email again"):
            email.value = "ada@y"

    rt, core = compose(Form)
    assert evaluations[0] == 1
    click(rt, core, "name")
    rt.frame()
    assert evaluations[0] == 2
    assert rt.recompositions["Form"] == 1, "the status did not change, so the scope was not recomposed"
    click(rt, core, "email")
    rt.frame()
    assert seen[-1] == "ok" and rt.recompositions["Form"] == 2
    click(rt, core, "email again")
    rt.frame()
    assert evaluations[0] == 4 and rt.recompositions["Form"] == 2


def test_a_write_during_composition_is_refused_and_the_tree_kept():
    errors: list[str] = []

    @composable
    def Bad():
        let n = state(0)
        Text(f"n = {n.value}")
        if n.value == 0:
            Button("go"):
                n.value = 1
        else:
            n.value = 2  # ty: ignore[state-write-in-composition] -- deliberate in this test

    core = FakeCore()
    rt = Runtime(core, on_error=lambda error, where: errors.append(type(error).__name__))
    rt.set_root(Bad)
    rt.frame()
    click(rt, core, "go")
    rt.frame()
    assert errors == ["CompositionError"]
    assert core.all_text() == ["n = 0", "go"], "the previous subtree stays on screen"


def test_state_refuses_a_mutable_value():
    try:
        _ = State([1, 2])  # ty: ignore[mutable-state-value] -- the runtime half of the rule is under test
    except TypeError as error:
        assert "cannot be held in state" in str(error)
    else:
        raise AssertionError("a list must not be accepted")


let theme = ambient("light")


@composable
def Themed(label: str):
    Text(f"{label}:{theme.current}")


@composable
def Ambients():
    let dark = state(False)
    Column:
        Themed("outer")
        provide(theme, "dark" if dark.value else "light"):
            Themed("inner")
        Button("toggle"):
            dark.value = not dark.value


def test_ambient_readers_below_a_provider_recompose():
    rt, core = compose(Ambients)
    assert core.all_text() == ["outer:light", "inner:light", "toggle"]
    click(rt, core, "toggle")
    rt.frame()
    assert core.all_text() == ["outer:dark" if False else "outer:light", "inner:dark", "toggle"]


def test_effects_restart_on_key_change_and_dispose_with_the_scope():
    log: list[str] = []
    tasks: list[object] = []

    @composable
    def Loader(uid: int):
        launched_effect(uid):
            log.append(f"start {uid}")  # ty: ignore[silent-mutation] -- deliberate in this test
            await asyncio.sleep(0)
            if it.is_active:
                log.append(f"done {uid}")  # ty: ignore[silent-mutation] -- deliberate in this test
        disposable_effect(uid):
            log.append(f"attach {uid}")  # ty: ignore[silent-mutation] -- deliberate in this test
            it.on_dispose(lambda: log.append(f"detach {uid}"))  # ty: ignore[silent-mutation] -- deliberate in this test
        Text(f"user {uid}")

    @composable
    def App():
        let uid = state(1)
        let shown = state(True)
        Column:
            if shown.value:
                Loader(uid.value)
            Button("next"):
                uid.value += 1
            Button("hide"):
                shown.value = False

    loop = asyncio.new_event_loop()
    core = FakeCore()
    rt = Runtime(core)
    rt.task_runner = lambda coroutine: loop.create_task(coroutine)
    rt.set_root(App)
    rt.frame()
    loop.run_until_complete(asyncio.sleep(0.01))
    assert log == ["attach 1", "start 1", "done 1"], "the task starts when the loop runs, after the synchronous effect"
    click(rt, core, "next")
    rt.frame()
    loop.run_until_complete(asyncio.sleep(0.01))
    assert log[3:] == ["detach 1", "attach 2", "start 2", "done 2"]
    click(rt, core, "hide")
    rt.frame()
    assert log[7:] == ["detach 2"]
    assert "user 2" not in core.all_text()
    loop.close()


@composable
def KeyInner():
    let hits = state(0)

    def handle(chord: str) -> bool:
        if chord == "x":
            hits.value += 1
            return True
        return False

    on_key(handle)
    Text(f"inner {hits.value}")


@composable
def KeyOuter():
    let hits = state(0)
    let shown = state(True)

    def handle(chord: str) -> bool:
        if chord == "hide":
            shown.value = False
        else:
            hits.value += 1
        return True

    on_key(handle)
    Column:
        Text(f"outer {hits.value}")
        if shown.value:
            KeyInner()


def test_key_handlers_run_deepest_scope_first_and_leave_with_their_scope():
    rt, core = compose(KeyOuter)
    assert rt.dispatch_key("x"), "the inner handler takes its chord"
    rt.frame()
    assert core.all_text() == ["outer 0", "inner 1"]
    assert rt.dispatch_key("y"), "the inner handler declines, the outer one takes it"
    rt.frame()
    assert core.all_text() == ["outer 1", "inner 1"]
    assert rt.dispatch_key("hide")
    rt.frame()
    assert core.all_text() == ["outer 1"]
    assert rt.dispatch_key("x"), "the disposed inner scope no longer listens; the outer handler counts it"
    rt.frame()
    assert core.all_text() == ["outer 2"]


def test_a_handler_sees_the_modifiers_of_its_event_and_nothing_outside_one():
    seen: list[str] = []

    @composable
    def Picker():
        Button("pick"):
            seen.append(input_modifiers())  # ty: ignore[silent-mutation] -- deliberate in this test

    rt, core = compose(Picker)
    rt.dispatch(core.handler_of("pick"), None, "shift+cmd")
    rt.dispatch(core.handler_of("pick"), None)
    assert seen == ["shift+cmd", ""]
    assert input_modifiers() == ""
    rt.dispatch(99, None)  # an unknown index is ignored, not an error


def test_a_write_from_another_thread_is_posted_to_the_ui_thread():
    import threading

    woken: list[int] = [0]
    cells: dict[str, State[int]] = {}

    @composable
    def Shown():
        let n = state(0)
        cells["n"] = n  # ty: ignore[silent-mutation, unobservable-dependency] -- deliberate in this test
        Text(f"n = {n.value}")

    core = FakeCore()
    rt = Runtime(core)
    rt.wake = lambda: woken.__setitem__(0, woken[0] + 1)
    rt.set_root(Shown)
    rt.frame()
    n = cells["n"]

    def worker():
        n.value = 7

    thread = threading.Thread(target=worker)
    thread.start()
    thread.join()
    assert n.value == 0, "the write was not applied on the worker thread"
    assert len(rt.posted) == 1 and woken[0] >= 1
    rt.frame()
    assert core.all_text() == ["n = 7"]


def test_a_failing_child_keeps_its_previous_subtree_and_the_siblings_render():
    errors: list[str] = []

    @composable
    def Flaky(step: int):
        if step == 1:
            raise ValueError("boom")
        Text(f"flaky {step}")

    @composable
    def Root():
        let step = state(0)
        Column:
            Text(f"step {step.value}")
            Flaky(step.value)
            Button("next"):
                step.value += 1

    core = FakeCore()
    rt = Runtime(core, on_error=lambda error, where: errors.append(f"{where}: {error}"))
    rt.set_root(Root)
    rt.frame()
    assert core.all_text() == ["step 0", "flaky 0", "next"]
    click(rt, core, "next")
    rt.frame()
    assert errors == ["root > Root > Flaky: boom"]
    assert core.all_text() == ["step 1", "flaky 0", "next"], "the failed scope keeps what was on screen"
    click(rt, core, "next")
    rt.frame()
    assert core.all_text() == ["step 2", "flaky 2", "next"], "it recovers on the next run"


def test_concurrent_writes_from_worker_threads_are_never_dropped():
    import threading

    lists: dict[str, StateList[int]] = {}

    @composable
    def Sink():
        let items = state_list[int]()
        lists["items"] = items  # ty: ignore[silent-mutation, unobservable-dependency] -- deliberate in this test
        Text(f"{len(items)} items")

    core = FakeCore()
    rt = Runtime(core)
    rt.set_root(Sink)
    rt.frame()
    items = lists["items"]
    threads = 8
    per_thread = 250

    def worker(offset: int):
        for i in range(per_thread):
            items.append(offset * per_thread + i)

    workers = [threading.Thread(target=worker, args=(n,)) for n in range(threads)]
    for w in workers:
        w.start()
    for w in workers:
        w.join()
    assert len(items) == 0, "nothing was applied on a worker thread"
    rt.frame()
    assert len(items) == threads * per_thread
    assert sorted(items) == list(range(threads * per_thread))
    assert core.all_text() == [f"{threads * per_thread} items"]


# ------------------------------------------------------------------- the trace


private def trace_of(rt: Runtime) -> Trace:
    trace = rt.trace
    assert trace is not None, "tracing is on by default"
    return trace


private def runs_named(rt: Runtime, name: str) -> list[dynamic]:
    """The run records of every scope called `name`, oldest first."""
    found: list[dynamic] = []
    for record in trace_of(rt).records:
        r: dynamic = record
        if r[0] == T_RUN and r[4] == name:
            found.append(r)
    return found


private def reruns_named(rt: Runtime, name: str) -> list[dynamic]:
    return [r for r in runs_named(rt, name) if r[10] != "first"]


private def writes(rt: Runtime) -> list[dynamic]:
    """The cause of every write record, oldest first."""
    found: list[dynamic] = []
    for record in trace_of(rt).records:
        r: dynamic = record
        if r[0] == T_WRITE:
            found.append(r[2])
    return found


private def only(items: list[dynamic]) -> dynamic:
    assert len(items) == 1, f"expected exactly one, got {items}"
    return items[0]


private def pair(items: list[dynamic]) -> (dynamic, dynamic):
    assert len(items) == 2, f"expected exactly two, got {items}"
    return (items[0], items[1])


private def records_of_kind(rt: Runtime, kind: int) -> list[dynamic]:
    found: list[dynamic] = []
    for record in trace_of(rt).records:
        r: dynamic = record
        if r[0] == kind:
            found.append(r)
    return found


private def line_of_text(path: str, needle: str) -> int:
    """The 1-based line of the one line containing `needle` in the file at `path`."""
    with open(path, encoding="utf-8") as handle:
        lines = handle.read().splitlines()
    hits = [index + 1 for index, line in enumerate(lines) if needle in line]
    assert len(hits) == 1, f"{needle!r} must appear exactly once in {path}, found it on lines {hits}"
    return hits[0]


def test_trace_state_cause_names_the_cell_and_the_writer():
    rt, core = compose(lambda: Counter(2))  # ty: ignore[composable-outside-composition] -- the helper forwards the lambda to set_root
    click(rt, core, "+")
    rt.frame()
    first, second = pair(runs_named(rt, "Counter"))
    assert first[10] == "first" and first[11] == (("created",),)
    assert second[10] == "self", "popped from the dirty heap"
    (cause,) = second[11]
    assert cause[0] == "state" and cause[2] == "state" and cause[3] == "set" and cause[4] is None
    assert cause[5] == 0 and cause[6] == 2, "old and new"
    generated = second[5]                       # where Counter is defined: this module, as generated
    # the needles are spelled in two parts so that these lines do not match themselves
    assert cause[7] == generated and cause[8] == line_of_text(generated, "count: Final" + " = state(0)")
    assert cause[9] == "count", "the name the slot was bound to, recovered from the bytecode"
    assert cause[10] == generated and cause[11] == line_of_text(generated, "count.value" + " += step")
    assert cause[12] == threading.get_ident() and cause[13] is False and cause[14] == 1
    assert writes(rt) == [cause], "one write record, carrying the same cause"


@composable
