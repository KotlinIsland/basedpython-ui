def test_trace_skipped_children_and_frame_counts():
    rt, core = compose(Parent)
    click(rt, core, "bump")
    rt.frame()
    leaves = [r[2] for r in runs_named(rt, "Leaf")]
    rerun = only(reruns_named(rt, "Parent"))
    assert rerun[12] == tuple(leaves), "the two leaves were emitted as references"
    frames = records_of_kind(rt, T_FRAME)
    assert [f[1] for f in frames] == [0, 1]
    assert frames[0][2] == 4 and frames[0][3] == 0, "root, Parent and the two leaves ran in the first frame"
    assert frames[1][2] == 1 and frames[1][3] == 2
    assert frames[1][4] > 0 and frames[1][5] > 0, "compose and commit took time"
    assert trace_of(rt).records[-1] === frames[1], "the frame record is the last of its frame"
    assert trace_of(rt).frames == 1


def test_trace_derived_chain_records_unchanged_and_changed_recomputes():
    @composable
    def Form():
        let name = state("")
        let email = state("")

        def check() -> str:
            n = name.value
            e = email.value
            return "ok" if "@" in e and n else "incomplete"

        let status = derived(check)
        Text(status.value)
        Button("name"):
            name.value = "ada"
        Button("email"):
            email.value = "ada@x"

    rt, core = compose(Form)
    click(rt, core, "name")
    rt.frame()
    state_write, derived_write = pair(writes(rt))
    assert state_write[0] == "state" and state_write[9] == "name" and state_write[14] == 1, "only the derived reads `name`"
    assert derived_write[0] == "derived" and derived_write[4] == "status"
    assert derived_write[5] == "incomplete" and derived_write[6] == "incomplete" and derived_write[7] is False
    assert derived_write[8] == state_write, "the derived cause carries the state cause that made it recompute"
    assert derived_write[2] == state_write[7], "declared in the same composable"
    assert len(runs_named(rt, "Form")) == 1, "unchanged: nothing ran"
    click(rt, core, "email")
    rt.frame()
    changed = writes(rt)[-1]
    assert changed[0] == "derived" and changed[7] is True and changed[6] == "ok" and changed[8][9] == "email"
    rerun = only(reruns_named(rt, "Form"))
    assert rerun[11] == (changed,), "the scope's cause is the derived cause, with the state cause inside"


def test_trace_posted_write_carries_the_writer_thread():
    cells: dict[str, State[int]] = {}

    @composable
    def Shown():
        let n = state(0)
        cells["n"] = n  # ty: ignore[silent-mutation, unobservable-dependency] -- deliberate in this test
        Text(f"n = {n.value}")

    core = FakeCore()
    rt = Runtime(core)
    rt.set_root(Shown)
    rt.frame()
    n = cells["n"]
    ident: list[int] = [0]

    def worker():
        ident[0] = threading.get_ident()
        n.value = 7

    thread = threading.Thread(target=worker)
    thread.start()
    thread.join()
    assert writes(rt) == [], "nothing is recorded until the ui thread applies the write"
    rt.frame()
    cause = only(writes(rt))
    assert cause[13] is True and cause[12] == ident[0] and cause[12] != threading.get_ident()
    assert cause[9] == "n" and cause[5] == 0 and cause[6] == 7
    rerun = only(reruns_named(rt, "Shown"))
    assert rerun[11] == (cause,)


