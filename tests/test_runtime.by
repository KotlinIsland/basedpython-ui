    let b = state(0)
    let c = state(0)
    Text(f"{a.value} {b.value} {c.value}")
    Button("all"):
        a.value += 1
        b.value += 1
        c.value += 1


def test_trace_three_writes_in_one_handler_are_three_causes_on_one_run():
    rt, core = compose(Triple)
    click(rt, core, "all")
    rt.frame()
    rerun = only(reruns_named(rt, "Triple"))
    causes = rerun[11]
    assert [cause[0] for cause in causes] == ["state", "state", "state"]
    assert [cause[9] for cause in causes] == ["a", "b", "c"], "in the order the writes happened"
    assert len(writes(rt)) == 3
    assert rt.recompositions["Triple"] == 2, "three causes, one recomposition"


