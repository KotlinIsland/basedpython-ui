@composable
def Brittle(step: int):
    if step == 1:
        raise ValueError("boom")
    Text(f"brittle {step}")


@composable
def Holder():
    let step = state(0)
    Column:
        Text(f"step {step.value}")
        Brittle(step.value)
        Button("next"):
            step.value += 1


def test_trace_error_record_then_recovery_cause():
    core = FakeCore()
    rt = Runtime(core, on_error=lambda error, where: None)
    rt.set_root(Holder)
    rt.frame()
    click(rt, core, "next")
    rt.frame()
    click(rt, core, "next")
    rt.frame()
    records = trace_of(rt).records
    error = only(records_of_kind(rt, T_ERROR))
    brittle = runs_named(rt, "Brittle")
    assert len(brittle) == 3
    assert error[1] == 1 and error[2] == brittle[1][2] and error[3] == "Brittle"
    assert error[4] == "boom" and error[5] is True, "the committed subtree stayed on screen"
    assert records.index(error) < records.index(brittle[1]), "the error is recorded as it happens, before the run's record"
    assert brittle[1][11] == (("args", "step", 0, 1, True),)
    assert brittle[2][11] == (("recovery", "boom"),)


