"""Application entry points and the headless test harness."""

import asyncio
import threading
from array import array
from collections.abc import Coroutine

from .runtime import Runtime, NativeCore, Task, State, Recomposition


# the appearance the window follows, "light" or "dark": set by `run_app` when the window
# opens and whenever the system changes it; a composition that reads it recomposes. headless
# compositions leave it at "light" unless a test sets it
let system_theme: State[str] = State("light")

# the size of the window this composition is in, in logical pixels: set when the window opens
# and on every resize, and by `compose_test` for a headless one. a layout that has to be
# decided rather than measured — how wide a resizable pane may be — reads it
let window_size: State[tuple[float, float]] = State((0.0, 0.0))


private def load_native() -> dynamic raises ImportError:
    from . import _native   # the rust core; a typed stub sits beside it

    return _native


class _TaskThread:
    """One asyncio loop on a background thread for `launched_effect` bodies.
    Every state write made from a task is posted back to the ui thread."""

    init(self):
        self.loop: asyncio.AbstractEventLoop = asyncio.new_event_loop()
        self.thread: threading.Thread = threading.Thread(target=self.loop.run_forever, name="basedpython-ui tasks", daemon=True)
        self.thread.start()

    def run(self, coroutine: Task) -> object:
        return asyncio.run_coroutine_threadsafe(coroutine, self.loop)

    def stop(self):
        _ = self.loop.call_soon_threadsafe(self.loop.stop)


let _CONTROL_CHORDS: dict[str, str] = {"\n": "enter", "\r": "enter", "\t": "tab", "\x1b": "escape", "\x08": "backspace", "\x7f": "delete", " ": "space"}


def chord_of_text(text: str) -> str:
    """The chord name of text typed with no field focused: control characters become
    "enter" / "tab" / "escape" / "backspace" / "delete" / "space", an upper-case letter
    "shift+<letter>", anything else is itself in lower case."""
    named = _CONTROL_CHORDS.get(text)
    if named is not None:
        return named
    if len(text) == 1 and text.isalpha() and text.isupper():
        return f"shift+{text.lower()}"
    return text.lower()


private def measure_dispatcher(rt: Runtime, core: NativeCore) -> object:
    def measure(handler_idx: int, child_count: int, min_w: float, max_w: float, min_h: float, max_h: float) -> (float, float):
        callback = rt.handlers[handler_idx]
        if callback is None:
            return (0.0, 0.0)
        size: dynamic = callback(core, child_count, min_w, max_w, min_h, max_h)
        return size

    return measure

class WindowEvents:
    """Turns the window's event tuples into runtime dispatches. The window delivers its
    first events (the size, the appearance) before the first frame creates the runtime, so
    what does not need one is handled regardless."""

    init(self):
        self.runtime: Runtime | None = None
        self.pressed: int = -1
        self.pressed_secondary: int = -1

    def handle(self, events: list[tuple[int, float, float, int, str]]):
        runtime = self.runtime
        for kind, x, y, handler_idx, text in events:
            if kind == 8:
                system_theme.value = text
                continue
            if kind == 5:
                window_size.value = (x, y)
                continue
            if runtime is None:
                continue
            match kind:
                case 1:
                    self.pressed = handler_idx
                case 2:
                    if handler_idx >= 0 and handler_idx == self.pressed:
                        runtime.dispatch(handler_idx, None, text, (x, y))
                    self.pressed = -1
                case 4:
                    if handler_idx >= 0:
                        runtime.dispatch(handler_idx, text)
                    else:
                        runtime.dispatch_key(chord_of_text(text))
                case 7:
                    runtime.dispatch_key(text)
                case 9:
                    self.pressed_secondary = handler_idx
                case 10:
                    if handler_idx >= 0 and handler_idx == self.pressed_secondary:
                        runtime.dispatch(handler_idx, None, text, (x, y))
                    self.pressed_secondary = -1
                case 11:
                    runtime.dispatch(handler_idx, text == "1", "", (x, y))
                case 12:
                    runtime.dispatch(handler_idx, text, "", (x, y))
                case 13:
                    runtime.dispatch(handler_idx, None, "", (x, y))
                case 14:
                    # a drag over a drop target: "over", "leave" or "drop"
                    runtime.dispatch(handler_idx, text, "", (x, y))
                case 15:
                    # a scroll container moved: its offset and its viewport's height
                    runtime.dispatch(handler_idx, None, "", (x, y))
                case 16:
                    # a press landed in a part of the window: the keyboard is its now
                    runtime.dispatch(handler_idx, None, "", (x, y))
                case _:
                    pass


# the window this process is running, while it runs: what another window is asked of
private var running_window: dynamic = None
private var running_tasks: dynamic = None


def open_window(title: str, width: int, height: int, trace: bool = True, root: () -> None) raises RuntimeError:
    """Open another window of the same application, composing `root` into it. One process,
    one event loop, one icon: the windows are siblings, not separate applications. Closing
    the last one ends the application. `trace=False` turns the recomposition trace off for
    this window's runtime."""
    let window: dynamic = running_window
    if window is None:
        raise RuntimeError("no window is running: open_window belongs inside run_app")
    let tasks: dynamic = running_tasks
    let events = WindowEvents()
    var measure: object = None

    def on_frame(core: NativeCore) -> bool:
        nonlocal measure
        rt = events.runtime
        if rt is None:
            rt = Runtime(core, trace=trace)
            if tasks is not None:
                rt.task_runner = tasks.run
            rt.wake = window.request_frame
            measure = measure_dispatcher(rt, core)
            rt.set_root(root)
            events.runtime = rt
        rt.frame(measure)
        core.paint()
        return not rt.is_idle()

    window.open(title, float(width), float(height), on_frame, events.handle)


def run_app(title: str = "basedpython-ui", width: int = 800, height: int = 600, icon: bytes? = None, name: str? = None, trace: bool = True, root: () -> None) raises ...:
    """Open a window, compose `root` into it and drive frames until the last window closes.
    Owns the main thread (the window system requires it).

    `icon` is an 8-bit rgba png: the window's icon where the platform has one, and the
    application's icon (the dock) on macos. `name` is what the application is called there,
    where `title` is what this window is showing. `open_window` opens another one alongside
    it. `trace=False` turns the recomposition trace off for this runtime."""
    global running_window, running_tasks
    native = load_native()
    window = native.Window(title, float(width), float(height), icon, name)
    tasks = _TaskThread()
    events = WindowEvents()
    measure: object = None

    def on_frame(core: NativeCore) -> bool:
        nonlocal measure
        rt = events.runtime
        if rt is None:
            rt = Runtime(core, trace=trace)
            rt.task_runner = tasks.run
            rt.wake = window.request_frame
            measure = measure_dispatcher(rt, core)
            rt.set_root(root)
            events.runtime = rt
        rt.frame(measure)
        core.paint()
        return not rt.is_idle()

    running_window = window
    running_tasks = tasks
    try:
        window.run(on_frame, events.handle)
    finally:
        running_window = None
        running_tasks = None
        tasks.stop()


class TestComposition:
    """A composition driven headlessly: the same runtime and the same native
    layout, no window, deterministic frames."""

    init(self, let runtime: Runtime, let core: NativeCore):
        self.loop: asyncio.AbstractEventLoop = asyncio.new_event_loop()
        self.measure: object = measure_dispatcher(runtime, core)
        runtime.task_runner = self.run_task

    private def run_task(self, coroutine: Task) -> object:
        return self.loop.create_task(coroutine)

    def advance(self, steps: int = 8):
        """Run pending recompositions, commit, layout and effects until idle
        (or `steps` frames), letting queued tasks make progress in between."""
        for _ in range(steps):
            self.runtime.frame(self.measure)
            # what the frame itself produced — a child asking to be revealed scrolls its
            # container, and the container is told — goes out against the handler table this
            # frame just built. left until the next pointer event it would be answered by
            # whatever had taken its index by then
            self._deliver()
            self.loop.run_until_complete(asyncio.sleep(0))
            if self.runtime.is_idle():
                return

    def find_text(self, text: str) -> bool:
        return self.core.find_text(text) is not None

    def all_text(self) -> (*: str):
        return tuple(self.core.all_text())

    def rect_of(self, text: str) -> tuple[float, float, float, float]:
        """`(x, y, w, h)` of the node showing `text`, in logical pixels."""
        found = self.core.find_text(text)
        if found is None:
            raise AssertionError(f"no node showing {text!r}; tree:\n{self.dump()}")
        _, x, y, w, h = found
        return (x, y, w, h)

    def _centre(self, text: str) -> tuple[float, float]:
        x, y, w, h = self.rect_of(text)
        return (x + w / 2.0, y + h / 2.0)

    def click(self, label: str, modifiers: str = ""):
        """Press and release the pointer over the node showing `label`, through
        the same hit test and event path a window uses; `modifiers` is what
        `input_modifiers()` reports inside the handler ("shift", "shift+cmd", …)."""
        cx, cy = self._centre(label)
        down = self.core.pointer(1, cx, cy)
        up = self.core.pointer(2, cx, cy)
        handler_idx = up[3]
        if handler_idx < 0 or handler_idx != down[3]:
            self._deliver()
            raise AssertionError(f"{label!r} is not clickable; tree:\n{self.dump()}")
        # the click first, then what it produced along the way: the order a window uses,
        # which is what lets a press close a menu and still do what it was aimed at
        self.runtime.dispatch(handler_idx, None, modifiers, (cx, cy))
        self._deliver()

    def right_click(self, label: str):
        """The right button over the node showing `label`: what opens a context menu."""
        cx, cy = self._centre(label)
        down = self.core.pointer(9, cx, cy)
        up = self.core.pointer(10, cx, cy)
        self._deliver()
        handler_idx = up[3]
        if handler_idx < 0 or handler_idx != down[3]:
            raise AssertionError(f"{label!r} offers no menu; tree:\n{self.dump()}")
        self.runtime.dispatch(handler_idx, None, "", (cx, cy))

    def _deliver(self):
        """Dispatch what the last pointer event produced: hover enters and leaves, the steps
        of a drag, and the presses that landed outside a `dismiss` layer."""
        for kind, x, y, handler_idx, text in self.core.take_events():
            # 13 is a dismiss and 15 a scroll: neither carries a payload, and a scroll's
            # position is its offset and the height of its viewport
            payload: object = None if kind in (13, 15, 16) else (text == "1" if kind == 11 else text)
            self.runtime.dispatch(handler_idx, payload, "", (x, y))

    def drag(self, label: str, dx: float, dy: float, steps: int = 2):
        """Press the node showing `label`, move by `(dx, dy)` and release: the whole drag,
        through the same capture a window goes through."""
        cx, cy = self._centre(label)
        self.core.pointer(1, cx, cy)
        self._deliver()
        for step in range(1, steps + 1):
            self.core.pointer(3, cx + dx * step / steps, cy + dy * step / steps)
            self._deliver()
        self.core.pointer(2, cx + dx, cy + dy)
        self._deliver()

    def press(self, chord: str) -> bool:
        """Offer a key chord ("cmd+x", "down", "shift+up", "enter") to the composition's
        `on_key` handlers, as the window does; True when one took it."""
        return self.runtime.dispatch_key(chord)

    def hover(self, label: str):
        """Move the pointer over the node showing `label`, delivering the enter and leave
        that produces."""
        cx, cy = self._centre(label)
        self.core.pointer(3, cx, cy)
        self._deliver()

    def hover_at(self, x: float, y: float):
        """Move the pointer to a point rather than to a node — how a hover is ended."""
        self.core.pointer(3, x, y)
        self._deliver()

    def hover_target(self) -> int:
        return self.core.hover_target()

    def select(self, from_label: str, to_label: str) -> str:
        """Sweep the pointer from the start of one text to the end of another, as a person
        selecting them would, and hand back what that picked out."""
        fx, fy, _, fh = self.rect_of(from_label)
        tx, ty, tw, th = self.rect_of(to_label)
        self.core.pointer(1, fx + 1.0, fy + fh / 2.0)
        self._deliver()
        self.core.pointer(3, tx + tw, ty + th / 2.0)
        self._deliver()
        self.core.pointer(2, tx + tw, ty + th / 2.0)
        self._deliver()
        return self.core.selected_text()

    def selected_text(self) -> str:
        return self.core.selected_text()

    def cursor_at(self, x: float, y: float) -> int:
        """What the pointer would look like at a point: 0 the platform's own, 1 a hand,
        2 a text bar, 3 a column-resize arrow, 4 a grabbing hand."""
        return self.core.cursor_at(x, y)

    def click_at(self, x: float, y: float):
        """Press and release at a point rather than on a node — what dismisses a menu or a
        selection."""
        down = self.core.pointer(1, x, y)
        up = self.core.pointer(2, x, y)
        self._deliver()
        if up[3] >= 0 and up[3] == down[3]:
            self.runtime.dispatch(up[3], None, "", (x, y))

    def hovered_handler(self) -> int:
        return self.core.hovered_handler()

    def scroll(self, label: str, dy: float) -> bool:
        """Turn the wheel by `dy` logical pixels (positive scrolls the content up) over the
        node showing `label`; True when a scroll container moved."""
        cx, cy = self._centre(label)
        return self.core.scroll(cx, cy, dy)

    def scroll_offset(self) -> float:
        """The offset of the first scroll container in tree order (0 when there is none)."""
        found = self.core.first_scroll()
        return found[1] if found is not None else 0.0

    def type_into(self, placeholder: str, text: str):
        """Focus the field showing `placeholder` (or its current value) and type `text`."""
        found = self.core.find_text(placeholder)
        if found is None:
            raise AssertionError(f"no text field showing {placeholder!r}; tree:\n{self.dump()}")
        _, x, y, w, h = found
        self.core.pointer(1, x + w / 2.0, y + h / 2.0)
        self.core.pointer(2, x + w / 2.0, y + h / 2.0)
        event = self.core.key_text(text)
        if event is None or event[3] < 0:
            raise AssertionError(f"{placeholder!r} did not take focus; tree:\n{self.dump()}")
        self.runtime.dispatch(event[3], event[4])

    def type_more(self, text: str):
        """Type into whatever field already has focus."""
        self._typed(self.core.key_text(text), text)

    def edit_key(self, name: str):
        """An editing key by name (Enter, Backspace, Left, …) into the focused field."""
        self._typed(self.core.key_named(name), name)

    def edit_chord(self, name: str, ctrl: bool = False, alt: bool = False, shift: bool = False, meta: bool = False) -> bool:
        """The same with modifiers held, as the window sends them. False when the field left
        the key alone, which is when the window makes it an application chord instead."""
        taken, event = self.core.key_edit(name, ctrl, alt, shift, meta)
        if taken and event is not None and event[3] >= 0:
            self.runtime.dispatch(event[3], event[4])
        return taken

    def caret(self) -> tuple[int, int, float, float]?:
        """where the caret is in the focused field, what it has selected, and how far the
        field has scrolled to keep it in sight"""
        return self.core.caret()

    def _typed(self, event: tuple[int, float, float, int, str]?, what: str):
        if event is None:
            raise AssertionError(f"{what!r} went nowhere: no field has focus")
        if event[3] >= 0:
            self.runtime.dispatch(event[3], event[4])

    def recompositions(self, fn: object) -> int:
        name = getattr(fn, "__name__", str(fn))
        return self.runtime.recompositions.get(name, 0)

    def why(self, fn: object) -> (*: Recomposition):
        """Every recorded run of the composable `fn`, oldest first, with the
        causes of each: matched by the function's identity, never by name.
        Empty when the composition was built with `trace=False`."""
        return self.runtime.recompositions_of(fn)

    def explain(self, since_frame: int? = None) -> str:
        """The runtime's trace as readable text (see `Runtime.explain`)."""
        return self.runtime.explain(since_frame)

    def dump(self) -> str:
        return self.core.dump()

    def dispose(self):
        """Dispose the runtime (it leaves `live_runtimes`) and close the task
        loop; `with compose_test(...) as t:` does this on the way out."""
        self.runtime.dispose()
        self.loop.close()

    def __enter__(self) -> TestComposition:
        return self

    def __exit__(self, exc_type: object, exc: object, tb: object):
        self.dispose()


def compose_test(width: int = 400, height: int = 300, trace: bool = True, root: () -> None) -> TestComposition raises ...:
    native = load_native()
    window_size.value = (float(width), float(height))
    core: NativeCore = native.Core(float(width), float(height), 1.0)
    rt = Runtime(core, trace=trace)
    t = TestComposition(rt, core)
    rt.set_root(root)
    t.advance()
    return t
