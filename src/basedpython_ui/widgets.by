"""Builders and scopes. Builders are module-level functions (a class cannot
take a trailing block) that emit fragment records into the current runtime;
scopes are the receivers of content blocks and carry only the modifiers that
are legal inside that container (`weight` in a `Row:`/`Column:`, `align` in a
`Box:`), exactly like Compose's `RowScope`."""

from array import array

from . import modifier as _modifier
from . import runtime as _runtime
from .geometry import Dp, Size, Constraints, Color, ONE_DP
from .modifier import Modifier, ModOp, Alignment, Arrangement, TextStyle
from .runtime import Runtime, NativeCore, CanvasRecorder, CompositionError, builder

# imports are lazy proxies; the values used on every builder call are bound
# to the real objects once, here, so a record never carries a proxy
let NONE = _modifier.NONE
let DEFAULT_TEXT_STYLE = _modifier.DEFAULT_TEXT_STYLE
let R_END = _runtime.R_END
let R_COLUMN = _runtime.R_COLUMN
let R_ROW = _runtime.R_ROW
let R_BOX = _runtime.R_BOX
let R_TEXT = _runtime.R_TEXT
let R_BUTTON = _runtime.R_BUTTON
let R_TEXTFIELD = _runtime.R_TEXTFIELD
let R_CHECKBOX = _runtime.R_CHECKBOX
let R_SPACER = _runtime.R_SPACER
let R_CANVAS = _runtime.R_CANVAS
let R_LAYOUT = _runtime.R_LAYOUT
let R_SCROLL = _runtime.R_SCROLL
let R_POPUP = _runtime.R_POPUP


class ColumnScope:
    def weight(self, value: float) -> Modifier:
        return Modifier((ModOp.Weight(value),))

    def align(self, alignment: Alignment) -> Modifier:
        return Modifier((ModOp.Align(alignment),))


class RowScope:
    def weight(self, value: float) -> Modifier:
        return Modifier((ModOp.Weight(value),))

    def align(self, alignment: Alignment) -> Modifier:
        return Modifier((ModOp.Align(alignment),))


class BoxScope:
    def align(self, alignment: Alignment) -> Modifier:
        return Modifier((ModOp.Align(alignment),))


let _COLUMN_SCOPE = ColumnScope()
let _ROW_SCOPE = RowScope()
let _BOX_SCOPE = BoxScope()


class DrawScope:
    """The receiver of a `Canvas:` block. Drawing commands are recorded and
    handed to the native painter in one batch."""

    init(self, let size: Size, let recorder: CanvasRecorder)

    def rect(self, x: float, y: float, width: float, height: float, color: Color):
        self.recorder.floats.extend((1.0, x, y, width, height, float(color.argb())))

    def circle(self, cx: float, cy: float, radius: float, color: Color):
        self.recorder.floats.extend((2.0, cx, cy, radius, float(color.argb())))

    def line(self, x1: float, y1: float, x2: float, y2: float, color: Color, stroke: Dp = ONE_DP):
        self.recorder.floats.extend((3.0, x1, y1, x2, y2, float(color.argb()), stroke.value))

    def text(self, text: str, x: float, y: float, style: TextStyle = DEFAULT_TEXT_STYLE):
        idx = len(self.recorder.strs)
        self.recorder.strs.append(text)
        self.recorder.floats.extend((4.0, x, y, float(idx), float(intern_style(self.recorder.runtime, style))))


class MeasureScope:
    """What a custom `Layout` measure function sees: its children, measured
    on demand, and placed by index."""

    init(self, let child_count: int, let core: NativeCore)

    def measure(self, index: int, constraints: Constraints) -> Size:
        width, height = self.core.measure_child(index, constraints.min_width, constraints.max_width, constraints.min_height, constraints.max_height)
        return Size(width, height)

    def place(self, index: int, x: float, y: float):
        self.core.place_child(index, x, y)


# ------------------------------------------------------------ encoding


private def encode_modifier(modifier: object, rt: Runtime) -> list[float]:
    ops: list[float] = []
    for op in (modifier cast! Modifier).ops:
        match op:
            case ModOp.Padding(left, top, right, bottom):
                ops.extend((1.0, left.value, top.value, right.value, bottom.value))
            case ModOp.Width(value):
                ops.extend((2.0, value.value))
            case ModOp.Height(value):
                ops.extend((3.0, value.value))
            case ModOp.FillMaxWidth:
                ops.append(4.0)
            case ModOp.FillMaxHeight:
                ops.append(5.0)
            case ModOp.Background(color):
                ops.extend((6.0, float(color.argb())))
            case ModOp.Weight(value):
                ops.extend((7.0, value))
            case ModOp.Align(alignment):
                ops.extend((8.0, float(alignment_code(alignment))))
            case ModOp.Clickable(on_click):
                ops.extend((9.0, float(rt.handler(on_click))))
            case ModOp.Rounded(top_left, top_right, bottom_right, bottom_left):
                ops.extend((10.0, top_left.value, top_right.value, bottom_right.value, bottom_left.value))
            case ModOp.Border(width, color):
                ops.extend((11.0, width.value, float(color.argb())))
            case ModOp.Hover(color):
                ops.extend((12.0, float(color.argb())))
            case ModOp.Shadow(elevation, color):
                ops.extend((13.0, elevation.value, float(color.argb())))
            case ModOp.Reveal:
                ops.append(14.0)
            case ModOp.Clip:
                ops.append(15.0)
            case ModOp.Secondary(on_click):
                ops.extend((16.0, float(rt.handler(on_click))))
            case ModOp.Hoverable(on_change):
                ops.extend((17.0, float(rt.handler(on_change))))
            case ModOp.Scrollbar(color):
                ops.extend((18.0, float(color.argb())))
            case ModOp.Drag(on_drag):
                ops.extend((19.0, float(rt.handler(on_drag))))
    return ops


private def encode_style(style: object) -> (float, float, int):
    s = style cast! TextStyle
    flags = (1 if s.bold else 0) | (2 if s.mono else 0) | (4 if s.nowrap else 0)
    return (s.size.value, float(s.color.argb()), flags)


private def alignment_code(alignment: Alignment) -> int:
    match alignment:
        case Alignment.Start:
            return 0
        case Alignment.Center:
            return 1
        case Alignment.End:
            return 2


private def arrangement_code(arrangement: Arrangement) -> int:
    match arrangement:
        case Arrangement.Start:
            return 0
        case Arrangement.Center:
            return 1
        case Arrangement.End:
            return 2
        case Arrangement.SpaceBetween:
            return 3
        case Arrangement.SpaceEvenly:
            return 4


private def intern_modifier(rt: Runtime, modifier: Modifier) -> int:
    if modifier === NONE or not modifier.ops:
        return 0
    # a clickable carries a handler index that is scope-owned, so the chain is
    # interned by its encoded ops rather than by the modifier value
    for op in modifier.ops:
        if op is ModOp.Clickable or op is ModOp.Secondary or op is ModOp.Hoverable or op is ModOp.Drag:
            return rt.modifier_id_for_ops(encode_modifier(modifier, rt))
    return rt.modifier_id(modifier, encode_modifier)


private def intern_style(rt: Runtime, style: TextStyle) -> int:
    return rt.style_id(style, encode_style)


private def composing() -> Runtime raises CompositionError:
    rt = _runtime._current
    if rt is None:
        raise CompositionError("builders only run inside a composable")
    return rt


private def key_flags(rt: Runtime) -> (int, int):
    return rt.current_key_flags() if rt.key_stack else (0, 0)


private def intern_text(rt: Runtime, text: str) -> int:
    idx = rt.str_index.get(text)
    return idx if idx is not None else rt.intern(text)


private def optional_modifier(rt: Runtime, modifier: Modifier) -> int:
    return 0 if modifier === NONE else intern_modifier(rt, modifier)


# ------------------------------------------------------------ builders


let _END_RECORD = (R_END, 0, -1, 0, -1, 0, 0, 0)


@builder
def Text(text: str, modifier: Modifier = NONE, style: TextStyle = DEFAULT_TEXT_STYLE, color: Color? = None) raises ...:
    rt = composing()
    flags, k = key_flags(rt)
    if color is not None:
        style = TextStyle(style.size, color, style.bold, style.mono, style.nowrap)
    rt.ints.extend((R_TEXT, flags, intern_text(rt, text), optional_modifier(rt, modifier), -1, intern_style(rt, style), k, 0))


@builder
def Button(label: str, modifier: Modifier = NONE, enabled: bool = True, on_click: () -> None) raises ...:
    rt = composing()
    flags, k = key_flags(rt)
    rt.ints.extend((R_BUTTON, flags, intern_text(rt, label), optional_modifier(rt, modifier), rt.handler(on_click), 1 if enabled else 0, k, intern_style(rt, DEFAULT_TEXT_STYLE)))


@builder
def TextField(value: str, modifier: Modifier = NONE, placeholder: str = "", on_change: (str) -> None) raises ...:
    rt = composing()
    flags, k = key_flags(rt)
    rt.ints.extend((R_TEXTFIELD, flags, intern_text(rt, value), optional_modifier(rt, modifier), rt.handler(on_change), 0, intern_text(rt, placeholder) if placeholder else -1, k))


@builder
def Checkbox(checked: bool, modifier: Modifier = NONE, on_change: (bool) -> None) raises ...:
    rt = composing()
    flags, k = key_flags(rt)
    # the core reports a click; the toggle is decided here from the committed value
    rt.ints.extend((R_CHECKBOX, flags, -1, optional_modifier(rt, modifier), rt.handler(lambda: on_change(not checked)), 1 if checked else 0, k, 0))


@builder
def Spacer(modifier: Modifier = NONE) raises ...:
    rt = composing()
    flags, k = key_flags(rt)
    rt.ints.extend((R_SPACER, flags, -1, optional_modifier(rt, modifier), -1, 0, k, 0))


@builder
def Column(modifier: Modifier = NONE, arrangement: Arrangement = Arrangement.Start, alignment: Alignment = Alignment.Start, once content: ColumnScope.() -> None) raises ...:
    """`arrangement` places the children along the column, `alignment` across it; a child's
    own `align` modifier overrides the latter."""
    rt = composing()
    flags, k = key_flags(rt)
    rt.ints.extend((R_COLUMN, flags, -1, optional_modifier(rt, modifier), -1, arrangement_code(arrangement), k, alignment_code(alignment)))
    rt.depth += 1
    content(_COLUMN_SCOPE)
    rt.depth -= 1
    rt.ints.extend(_END_RECORD)


@builder
def Row(modifier: Modifier = NONE, arrangement: Arrangement = Arrangement.Start, alignment: Alignment = Alignment.Start, once content: RowScope.() -> None) raises ...:
    """`arrangement` places the children along the row, `alignment` across it (`Center`
    is what makes a row of differently sized things share a centre line)."""
    rt = composing()
    flags, k = key_flags(rt)
    rt.ints.extend((R_ROW, flags, -1, optional_modifier(rt, modifier), -1, arrangement_code(arrangement), k, alignment_code(alignment)))
    rt.depth += 1
    content(_ROW_SCOPE)
    rt.depth -= 1
    rt.ints.extend(_END_RECORD)


@builder
def Box(modifier: Modifier = NONE, alignment: Alignment = Alignment.Start, once content: BoxScope.() -> None) raises ...:
    rt = composing()
    flags, k = key_flags(rt)
    rt.ints.extend((R_BOX, flags, -1, optional_modifier(rt, modifier), -1, alignment_code(alignment), k, 0))
    rt.depth += 1
    content(_BOX_SCOPE)
    rt.depth -= 1
    rt.ints.extend(_END_RECORD)


@builder
def Scroll(modifier: Modifier = NONE, alignment: Alignment = Alignment.Start, once content: ColumnScope.() -> None) raises ...:
    """A vertically scrolling column: the content may be taller than the node, which takes
    the height its constraints give it (`fill_max_height` / `weight` make it the viewport).
    The wheel scrolls it; a child with `Modifier().reveal()` is scrolled into view. Once the
    content overflows, it is laid out narrower by the width of the scrollbar, which
    therefore never covers it."""
    rt = composing()
    flags, k = key_flags(rt)
    rt.ints.extend((R_SCROLL, flags, -1, optional_modifier(rt, modifier), -1, 0, k, alignment_code(alignment)))
    rt.depth += 1
    content(_COLUMN_SCOPE)
    rt.depth -= 1
    rt.ints.extend(_END_RECORD)


@builder
def Popup(x: Dp, y: Dp, modifier: Modifier = NONE, once content: ColumnScope.() -> None) raises ...:
    """Content that floats over the window at `(x, y)` — a menu, a tooltip. It is outside
    the layout of the container it is written in (it takes no space there), it is painted
    after everything else, it is hit before everything else, no ancestor's `clip` applies to
    it, and it is moved back inside the window when it would not fit."""
    rt = composing()
    flags, k = key_flags(rt)
    rt.ints.extend((R_POPUP, flags, -1, optional_modifier(rt, modifier), -1, int(x.value), k, int(y.value)))
    content(_COLUMN_SCOPE)
    rt.ints.extend(_END_RECORD)


@builder
def Canvas(modifier: Modifier = NONE, on_draw: DrawScope.() -> None) raises ...:
    rt = composing()
    flags, k = key_flags(rt)

    def draw(recorder: CanvasRecorder):
        on_draw(DrawScope(Size(recorder.width, recorder.height), recorder))

    rt.emit(R_CANVAS, flags, -1, intern_modifier(rt, modifier), rt.handler(draw), 0, k, 0)


@builder
def Layout(measure: (MeasureScope, Constraints) -> Size, modifier: Modifier = NONE, once content: () -> None) raises ...:
    rt = composing()
    flags, k = rt.current_key_flags()

    def measure_callback(core: NativeCore, child_count: int, min_w: float, max_w: float, min_h: float, max_h: float) -> (float, float):
        size = measure(MeasureScope(child_count, core), Constraints(min_w, max_w, min_h, max_h))
        return (size.width, size.height)

    rt.emit(R_LAYOUT, flags, -1, intern_modifier(rt, modifier), rt.handler(measure_callback), 0, k, 0)
    rt.depth += 1
    content()
    rt.depth -= 1
    rt.end()
