"""Modifiers: an immutable, ordered chain of layout / draw / input operations
(Compose's `Modifier`). Chains are values — equal chains compare equal, so a
composable receiving the same chain twice can be skipped."""

from .geometry import Dp, Color, ZERO_DP, BLACK


enum class Alignment:
    case Start, Center, End


enum class Arrangement:
    case Start, Center, End, SpaceBetween, SpaceEvenly


frozen data class TextStyle:
    size: Dp = Dp(14.0)
    color: Color = Color(32, 32, 32)
    bold: bool = False
    # shape with the monospace family
    mono: bool = False
    # never wrap: one line, cut off at the node's edge when it is wider
    nowrap: bool = False


let DEFAULT_TEXT_STYLE = TextStyle()
let SHADOW_COLOR = Color(0, 0, 0, 40)


enum class CursorShape:
    """What the pointer looks like: the platform's own arrow, the hand it shows over
    something to click, the bar it shows over text, the arrow it shows over a column edge
    that can be dragged, or the closed hand of something being dragged."""

    case Default, Hand, Text, ColumnResize, Grabbing


def cursor_code(shape: CursorShape) -> int:
    match shape:
        case CursorShape.Default:
            return 0
        case CursorShape.Hand:
            return 1
        case CursorShape.Text:
            return 2
        case CursorShape.ColumnResize:
            return 3
        case CursorShape.Grabbing:
            return 4


enum class ModOp:
    case Padding(left: Dp, top: Dp, right: Dp, bottom: Dp)
    case Width(value: Dp)
    case Height(value: Dp)
    case FillMaxWidth
    case FillMaxHeight
    case Background(color: Color)
    case Weight(value: float)
    case Align(alignment: Alignment)
    case Clickable(on_click: () -> None)
    # corner radii for every background, border, shadow and hover layer after it in the chain
    case Rounded(top_left: Dp, top_right: Dp, bottom_right: Dp, bottom_left: Dp)
    case Border(width: Dp, color: Color)
    # painted over the clickable layer while the pointer is over it
    case Hover(color: Color)
    # a soft drop shadow under the layer; `elevation` is its spread
    case Shadow(elevation: Dp, color: Color)
    # ask the nearest `Scroll` to bring the node into view when this op appears
    case Reveal
    # clip the node's own painting and its children to the node's rect
    case Clip
    # the secondary (right) button over this layer
    case Secondary(on_click: () -> None)
    # told when the pointer enters and leaves this layer
    case Hoverable(on_change: (bool) -> None)
    # the colour of a scroll container's thumb
    case Scrollbar(color: Color)
    # told when the pointer is pressed here and dragged, wherever it then goes
    case Drag(on_drag: (str) -> None)
    # the text under here can be swept over with the pointer; the colour is the highlight's
    case Selectable(color: Color)
    # what the pointer looks like over this node
    case Cursor(shape: CursorShape)
    # a text field that holds more than one line
    case Multiline
    # told when the pointer is pressed anywhere but here, without taking the press
    case Dismiss(on_dismiss: () -> None)
    # space a row or column puts between its children
    case Gap(value: Dp)
    # painted over the clickable layer while the pointer is held down on it
    case Pressed(color: Color)
    # told when a drag passes over this node, leaves it, or is let go on it
    case DropTarget(on_drop: (str) -> None)


frozen data class Modifier:
    ops: (*: ModOp) = ()

    def then(self, op: ModOp) -> Modifier:
        return Modifier(self.ops + (op,))

    def padding(self, all: Dp) -> Modifier:
        return self.then(ModOp.Padding(all, all, all, all))

    def padding_hv(self, horizontal: Dp, vertical: Dp) -> Modifier:
        return self.then(ModOp.Padding(horizontal, vertical, horizontal, vertical))

    def width(self, value: Dp) -> Modifier:
        return self.then(ModOp.Width(value))

    def height(self, value: Dp) -> Modifier:
        return self.then(ModOp.Height(value))

    def size(self, width: Dp, height: Dp) -> Modifier:
        return self.then(ModOp.Width(width)).then(ModOp.Height(height))

    def fill_max_width(self) -> Modifier:
        return self.then(ModOp.FillMaxWidth)

    def fill_max_height(self) -> Modifier:
        return self.then(ModOp.FillMaxHeight)

    def fill_max_size(self) -> Modifier:
        return self.then(ModOp.FillMaxWidth).then(ModOp.FillMaxHeight)

    def background(self, color: Color) -> Modifier:
        return self.then(ModOp.Background(color))

    def clickable(self, on_click: () -> None) -> Modifier:
        return self.then(ModOp.Clickable(on_click))

    def rounded(self, radius: Dp) -> Modifier:
        return self.then(ModOp.Rounded(radius, radius, radius, radius))

    def rounded_corners(self, top_left: Dp, top_right: Dp, bottom_right: Dp, bottom_left: Dp) -> Modifier:
        """Round each corner on its own — what makes a run of adjacent nodes read as one
        shape: round the outer corners of the run and leave the seams square."""
        return self.then(ModOp.Rounded(top_left, top_right, bottom_right, bottom_left))

    def rounded_top(self, radius: Dp) -> Modifier:
        return self.rounded_corners(radius, radius, ZERO_DP, ZERO_DP)

    def rounded_bottom(self, radius: Dp) -> Modifier:
        return self.rounded_corners(ZERO_DP, ZERO_DP, radius, radius)

    def border(self, width: Dp, color: Color) -> Modifier:
        return self.then(ModOp.Border(width, color))

    def hover(self, color: Color) -> Modifier:
        """Paint `color` over the clickable layer of this chain while the pointer is over it."""
        return self.then(ModOp.Hover(color))

    def shadow(self, elevation: Dp, color: Color = SHADOW_COLOR) -> Modifier:
        return self.then(ModOp.Shadow(elevation, color))

    def reveal(self, when: bool = True) -> Modifier:
        """Scroll the node into view when `when` turns true (a selection moving with the keyboard)."""
        return self.then(ModOp.Reveal) if when else self

    def clip(self) -> Modifier:
        return self.then(ModOp.Clip)

    def on_secondary(self, on_click: () -> None) -> Modifier:
        """The right button over this layer. It falls through buttons and text fields, so a
        row can offer a menu without every widget on it having to forward one."""
        return self.then(ModOp.Secondary(on_click))

    def hoverable(self, on_change: (bool) -> None) -> Modifier:
        """Called with True when the pointer enters this layer and False when it leaves —
        what a tooltip hangs off. `input_position()` says where the pointer is."""
        return self.then(ModOp.Hoverable(on_change))

    def scrollbar(self, color: Color) -> Modifier:
        """The colour of this `Scroll`'s thumb, for a theme the default does not suit."""
        return self.then(ModOp.Scrollbar(color))

    def dismiss(self, on_dismiss: () -> None) -> Modifier:
        """Told when the pointer is pressed anywhere outside this node. The press itself is
        not taken: it goes on to whatever it landed on, so a menu can close on a click that
        still does what it was aimed at."""
        return self.then(ModOp.Dismiss(on_dismiss))

    def gap(self, size: Dp) -> Modifier:
        """Space a `Row`, `Column` or `Scroll` puts between each pair of its children. The
        container spaces itself, so the number is written once instead of at every join."""
        return self.then(ModOp.Gap(size))

    def pressed(self, color: Color) -> Modifier:
        """Painted over this layer while the pointer is held down on it, the way `hover` is
        painted while the pointer is over it. Without it a click has no feedback at all
        between the press and whatever it sets off."""
        return self.then(ModOp.Pressed(color))

    def drop_target(self, on_drop: (str) -> None) -> Modifier:
        """Called with "over" when a drag comes onto this node, "leave" when it goes off
        again, and "drop" when it is let go here. `draggable` says where the pointer is;
        this says what is under it, which is what a drag that moves a thing needs."""
        return self.then(ModOp.DropTarget(on_drop))

    def multiline(self) -> Modifier:
        """A `TextField` that takes more than one line: it wraps inside the width it is
        given, grows down as it fills, and Enter puts a line break in."""
        return self.then(ModOp.Multiline)

    def cursor(self, shape: CursorShape) -> Modifier:
        """What the pointer looks like over this node. The innermost one under the pointer
        wins, so a row can set a shape and a widget inside it can override it."""
        return self.then(ModOp.Cursor(shape))

    def selectable(self, highlight: Color) -> Modifier:
        """The `Text` inside this node can be selected by sweeping the pointer across it,
        across as many of them as the sweep covers. `selected_text()` reads what was picked
        out; a press that selects nothing clears it."""
        return self.then(ModOp.Selectable(highlight))

    def draggable(self, on_drag: (str) -> None) -> Modifier:
        """Called with "start", then "move" for every step, then "end". The pointer belongs
        to this layer for the whole drag, however far it travels, so a handle keeps following
        it once it has left; `input_position()` says where it is."""
        return self.then(ModOp.Drag(on_drag))


let NONE = Modifier()
